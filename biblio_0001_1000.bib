@article{ WOS:001822198500001,
Author = {Manohar, Ankitha and Forster, Piers and Robinson, Danielle and Beger,
   Maria},
Title = {Remote sensing and machine learning for inferred mariculture site
   suitability in data-limited tropical coasts: A case study from the
   Philippines},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {97},
Month = {AUG},
Abstract = {Sustainable expansion of marine aquaculture (mariculture) in
   data-limited tropical coasts requires spatially explicit tools for site
   selection. In the Philippines, allocation of mariculture sites remains
   largely opportunistic, with limited use of Earth observation and machine
   learning to account for spatial and environmental complexity. Here, we
   develop and compare two models based on Random Forest (RF) and Gradient
   Tree Boosting (GTB) to predict the spatial distribution of existing
   mariculture sites and identify spatial patterns consistent with existing
   mariculture locations in selected Philippine coastal municipalities. The
   analysis is implemented within a reproducible Google Earth Engine
   workflow that integrates Sentinel-2 multispectral imagery,
   satellite-derived bathymetry and spectral indices (NDWI, MNDWI and
   NDMI), alongside multi-year sea surface temperature and chlorophyll-a
   data to characterise environmental conditions associated with
   mariculture occurrence. Both classifiers achieve strong performance on
   held-out validation data, with GTB reaching 96\% precision, 96\% recall
   and 94.74\% overall accuracy and RF reaching 92.31\% precision, 96\%
   recall and 92.11\% overall accuracy, indicating conservative detection
   of locations sharing spatial- environmental characteristics with
   existing mariculture sites. Bathymetry emerges as the most influential
   predictor across models, with high-probability areas concentrated at
   depths of around 2.25 m, while sea surface temperature and chlorophyll-a
   show potential to further refine predictions. The resulting maps
   represent a screening layer reflecting environmental similarity to
   existing mariculture locations rather than a full socio-ecological
   suitability assessment. These results demonstrate the potential of
   tree-based classification methods, applied to freely available satellite
   data, as a robust and scalable workflow for screening mariculture sites.
   Rather than prescribing ecologically optimal conditions, the models
   reveal environmental and spatial signatures embedded in existing
   mariculture distributions, illustrating how machine learning can extract
   useful environmental patterns even from imperfect datasets. The approach
   can support local institutions in the Philippines in spatial planning
   for mariculture expansion and offers a transferable template for other
   data-scarce tropical coastal regions.},
