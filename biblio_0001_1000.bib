@incollection{ WOS:000333925800003,
Author = {Fath, B. D. and Jorgensen, S. E. and Scharler, U. M.},
Editor = {Wolanski, E and McLusky, D},
Title = {Ecological Modeling in Environmental Management: History and
   Applications},
Booktitle = {TREATISE ON ESTUARINE AND COASTAL SCIENCE, VOL 9: ESTUARINE AND COASTAL
   ECOSYSTEM MODELLING},
Year = {2011},
Pages = {23-33},
Abstract = {In this chapter, we provide an overview of the rise of ecological
   modeling as a problem-solving tool for environmental management
   including a review of some of the more important and widely used models.
   While there has been a great increase in the computing power available
   to simulate ecological systems, a few fundamental concepts, which were
   already identified in the early days of ecological modeling, are still
   unresolved. These include boundary formulation, objective function
   identification, data requirements, subsystem integration, clarity on the
   acceptability of assumptions, and effective communication of results to
   decision makers. In order for ecological modeling to realize its full
   potential, further progress is needed in these areas. By looking back
   over the history and successes of this important approach, we hope to
   set the stage for the next period of development to address these
   issues.},
