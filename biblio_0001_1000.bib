@article{ WOS:001744895900001,
Author = {Anaba, Clement Issaka and Addaney, Michael and Kabo-bah, Amos Tiereyangn},
Title = {Implications of Wetlands Degradation on Urban Water Security and Climate
   Resilience: A Systematic Review and Meta-synthesis of Assessment
   Techniques},
Journal = {WETLANDS},
Year = {2026},
Volume = {46},
Number = {5},
Month = {APR 20},
Abstract = {This systematic review and meta-synthesis explored mapping and modelling
   approaches to wetland degradation, addressing the urgent need for
   accurate assessment and prediction of wetland changes in the context of
   urban water security, climate resilience, and sustainable development.
   Utilizing the PRISMA framework, peer-reviewed articles and specialized
   reports from 2001 to 2025 were comprehensively analyzed to identify key
   methodologies, including Geographic Information Systems (GIS), Remote
   Sensing (RS), and machine learning models such as Artificial Neural
   Networks (ANN) and Cellular Automata-Markov chains. The review
   highlights the effectiveness of these tools in mapping wetland surface
   areas, predicting land-use changes that impact wetlands, and assessing
   ecosystem health. It emphasizes the critical role of wetlands in urban
   water security through water cycle regulation, flood mitigation, and
   groundwater recharge, while also underscoring how wetland degradation
   exacerbates water scarcity, pollution, and flood risks, particularly in
   urbanizing regions. Furthermore, the interconnected nexus of wetlands,
   climate change, and urban resilience is explored, promoting the
   integration of wetlands as green-blue infrastructure in urban planning.
   The review concludes by outlining future research directions focused on
   refining predictive models, fostering community engagement, and aligning
   wetland conservation with sustainable development goals, and proposing
   recommendations for sustainable wetland management to enhance urban
   resilience and ecological integrity.},
