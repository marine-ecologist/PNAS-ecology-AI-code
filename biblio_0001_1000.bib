@article{ WOS:001826406800001,
Author = {Hiwatashi, Rintaro and Kitakado, Toshihide},
Title = {DM-SPM: Deep-Markov-based-surplus production model},
Journal = {ECOLOGICAL MODELLING},
Year = {2026},
Volume = {521},
Month = {NOV},
Abstract = {Surplus production models (SPMs) are widely employed to reconstruct
   latent biomass and its dynamics in exploited populations. However,
   conventional SPMs typically impose a fixed parametric family for the
   surplus production relationship, and misspecification of this functional
   form can induce systematic bias in estimated stock status and associated
   quantities. This paper proposes a state-space SPM that estimates the
   surplus production relationship without assuming a specific parametric
   family, while retaining the accounting structure of SPMs. The key idea
   is to represent surplus production as a flexible function of biomass
   using a neural network embedded in a deep Markov model, while imposing
   basic boundary conditions from an ecological perspective. Model
   parameters and latent biomass trajectories are estimated with stochastic
   variational inference. The proposed model was evaluated in simulation
   experiments using a set of operating models. The true surplus production
   relationship is either consistent with conventional fixed-shape
   assumptions or exhibits nonlinearity at low biomass. Across the
   experimental scenarios, the proposed model and a conventional
   Pella-Tomlinson model reconstructed latent biomass trajectories with
   similarly small bias. In contrast, clearer differences emerged in the
   estimated surplus production relationship and inferred process error.
   Under shape misspecification, the proposed model better captured
   nonlinearity at low biomass within the experienced biomass range and
   reduced systematic structure in the process error. However, the
   estimated shapes were unstable near the boundaries of the experienced
