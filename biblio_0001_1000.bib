@article{ WOS:001497889400001,
Author = {Villafuerte-Jordan, Rafael and Boveda, Paula and Del Barrio, Jose M.
   Garcia and Delibes-Mateos, Miguel and Martinez-Jauregui, Maria},
Title = {The spatial dynamics of red deer (Cervus elaphus) in fenced
   Mediterranean landscapes during periods of limited resources},
Journal = {EUROPEAN JOURNAL OF WILDLIFE RESEARCH},
Year = {2025},
Volume = {71},
Number = {3},
Month = {JUN},
Abstract = {Two opposite spatial dynamics of red deer (Cervus elaphus L.) occur in
   Mediterranean landscapes at the end of the summer: a higher segregation
   of animals during periods of food scarcity versus the aggregation of
   individuals of both sexes for reproductive purposes. Nevertheless, red
   deer spatial dynamics and activity patterns may differ in fenced areas,
   where high deer numbers are reached artificially through intensive
   management. Yet, such effects remain insufficiently investigated in the
   literature, despite the prevalence of fenced estates in Mediterranean
   landscapes within central-southern Iberian Peninsula. We used camera
   traps and Random Forest to analyze how environmental and anthropogenic
   factors affected red deer spatial dynamics in a perimeter-fenced
   Mediterranean landscape during the period of the year when food
   resources are most limited. Our key findings indicated that females
   selected areas with higher-quality food resources, and elevated
   nutritional needs due to lactation, corresponding to the flat, humid
   lowland areas. In contrast, males demonstrated a less concentrated
   distribution, although during the rut they migrated towards territories
   with females. Conversely, daily activity patterns did not differ
   significantly between sexes. The Random Forest model revealed how
   altitude, slope, and proximity to water sources or supplementary crops
   influenced deer spatial dynamics. Our findings emphasized the importance
   of assessing seasonal movement patterns of deer within fenced areas to
   determine whether their behavior aligns with natural conditions and if
   the enclosed landscape ensures adequate environmental heterogeneity.
   When these requirements are met, fenced landscapes can contribute to the
   health of deer populations and ecosystems. Therefore, such assessments
   (i.e., camera trap monitoring and spatial modeling of seasonal movement
   patterns) can subsequently be used as an additional indicator of good
   deer management practices, complementing those already in use.},
