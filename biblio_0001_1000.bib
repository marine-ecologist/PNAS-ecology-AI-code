@article{ WOS:001852739400001,
Author = {Strbac, Snezana and Pezo, Lato and Loncar, Biljana and Milutinovic,
   Dragana and Roncevic, Vukasin and Zivanovic, Nikola},
Title = {A socio-ecological framework for integrating resident perceptions,
   stakeholder valuations, and canopy structural characteristics in urban
   forest ecosystem-service assessment},
Journal = {ECOSYSTEM SERVICES},
Year = {2026},
Volume = {81},
Month = {OCT},
Abstract = {Urban forests contribute to urban sustainability through the provision
   ecosystem services and benefits for human well-being. However,
   assessments often remain fragmented, focusing either on ecological
   characteristics or on social valuation. This study develops an
   integrated socio-ecological framework that combines ecosystem-service
   perceptions, stakeholder valuation, and canopy structural
   characteristics to support a more holistic understanding of urban forest
   systems. The study used a peri-urban forest in Belgrade, Serbia, as a
   case study and integrated resident survey data (n = 198) and
   stakeholder-based ecosystem-service valuations with field-based canopy
   measurements, wich were analysed using machine learning models. Social
   data were examined using multivariate statistical analyses to identify
   patterns of ecosystem-service perception and forest-related attitudes.
   Ecological structure was characterised using radiometric and
   architectural canopy parameters modelled with artificial neural networks
   (ANN), random forests (RF), and support vector machines (SVM). The
   results indicate a strong association between recognition of regulating
   ecosystem services and stewardship-oriented attitudes towards forest
   protection, suggesting that ecological awareness is linked to
   pro-conservation orientations. Stakeholder valuations showed that
   ecosystem-service priorities were broadly shared but articulated through
   different experiences, responsibilities, and knowledge systems. Canopy
   structural characteristics indicated a relatively dense and structurally
   heterogeneous forest canopy, while machine learning models achieved high
   predictive performance for radiometric variables and moderate
   performance for structural canopy attributes. Using a socioecological
   framework, the study demonstrates how complementary sources of evidence
   can improve understanding of urban forest ecosystem services. This model
   offers a transferable approach for socio-ecological assessment and
   supports more inclusive urban forest planning and adaptive governance.},
