   Li, R.; Li, L.; Huang, L., Guangxi Inst Water Resources Res, Nanning 530023, Peoples R China.
   Li, R.; Li, L.; Huang, L., Guangxi Key Lab Water Engn Mat \& Struct, Nanning 530023, Peoples R China.
   Tao, J., Harbin Inst Technol, Harbin 150080, Heilongjiang, Peoples R China.
   Luo, F.; Norgbey, E., Hohai Univ, Coll Environm, Nanjing 210098, Jiangsu, Peoples R China.},
DOI = {10.15666/aeer/1701\_437449},
ISSN = {1589-1623},
EISSN = {1785-0037},
