@article{ WOS:000186869700033,
Author = {Park, YS and Chang, JB and Lek, S and Cao, WX and Brosse, S},
Title = {Conservation strategies for endemic fish species threatened by the Three
   Gorges Dam},
Journal = {CONSERVATION BIOLOGY},
Year = {2003},
Volume = {17},
Number = {6},
Pages = {1748-1758},
Month = {DEC},
Abstract = {The largest damming project to date, the Three Gorges Dam has been built
   along the Yangtze River (China), the most species-rich river in the
   Palearctic region. Among 162 species of fish inhabiting the main channel
   of the upper Yangtze, 44 are endemic and are therefore under serious
   threat of global extinction from the dam. Accordingly, it is urgently
   necessary to develop strategies to minimize the impacts of the drastic
   environmental changes associated with the dam. We sought to identify
   potential reserves for the endemic species among the 17 tributaries in
   the upper Yangtze, based on presence/absence data for the 44 endemic
   species. Potential reserves for the endemic species were identified by
   characterizing the distribution patterns of endemic species with an
   adaptive learning algorithm called a ``self-organizing map{''} (SOM).
   Using this method, we also predicted occurrence probabilities of species
   in potential reserves based on the distribution patterns of communities.
   Considering both SOM model results and actual knowledge of the biology
   of the considered species, our results suggested that 24 species may
   survive in the tributaries, 14 have an uncertain future, and 6 have a
   high probability of becoming extinct after dam filling.},
