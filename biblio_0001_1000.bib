@article{ WOS:001800417200001,
Author = {Zhang, Jialu and Rusuli, Yusufujiang and Wu, Haizhi and Zhao, Xiuli},
Title = {Overcoming sample scarcity: UAV mapping of arid wetlands based on
   cluster validity and pseudo-labels},
Journal = {JOURNAL OF ARID ENVIRONMENTS},
Year = {2026},
Volume = {236},
Month = {JUL},
Abstract = {Accurate and fine-scale mapping of arid wetlands is critical for
   ecological conservation, yet it is heavily constrained by the scarcity
   of field-labeled samples in complex and inaccessible environments. To
   address this challenge, this study proposes an automated wetland mapping
   framework utilizing multispectral unmanned aerial vehicle (UAV) imagery,
   taking the Bosten Lake wetland-a typical arid inland lake wetland in
   Xinjiang, China-as a case study. We developed a pseudo-label-driven
   classification framework that integrates unsupervised clustering with
   Random Forest (RF) classification to reduce reliance on labor-intensive
   manual labeling. By systematically evaluating various clustering
   algorithms and Cluster Validity Indices (CVIs), our results demonstrate
   that the kmeans\_rcpp algorithm is highly robust in spectrally complex
   arid wetland environments, effectively distinguishing critical
   land-cover types such as Reed and Suaeda salsa from water bodies and
   salt marshes. The high-quality pseudo-labels significantly improved RF
   classification accuracy, while external CVIs showed stable positive
   correlations with RF accuracy and outperformed internal CVIs in
   reflecting pseudo-label effectiveness. This study offers an efficient,
   low-cost, and transferable UAV-based method for automated arid wetland
   mapping, supporting wetland degradation monitoring and salinization risk
   identification with high-resolution spatial information.},
