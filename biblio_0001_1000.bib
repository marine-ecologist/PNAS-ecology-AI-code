@article{ WOS:001865385400001,
Author = {Chen, S. and Zhao, H. X. and Feng, J. P.},
Title = {IDENTIFICATION OF KEY DRIVING FACTORS FOR THE IMPROVEMENT OF PHYSICAL
   AND CHEMICAL PROPERTIES OF SALINE-ALKALI SOIL BY PHYTOREMEDIATION: BASED
   ON META-ANALYSIS},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Month = {2026 JUL 13},
Abstract = {The expansion of saline-alkali soils threatens global agriculture and
   ecology. A systematic quantitative assessment of phytoremediation's
   effects on soil physicochemical properties remains lacking. This
   meta-analysis synthesized 57 field-based control trials (2005-2025),
   extracting effect sizes for BD, pH, EC, Ex-Na, SOM, AP, and TN. Hedge's
   g with a random-effects model (REML) was used for pooling, and subgroup
   analysis plus random forest identified key drivers. Results showed
   significant increases in AP (3.64), SOM (2.57), and TN (2.30), and
   significant reductions in Ex-Na (-3.80), EC (-3.61), BD (-1.51), and pH
   (-1.22), all P < 0.001. Subgroup analysis indicated that irrigation
   favored salinity-alkalicity reduction, while rainfed conditions enhanced
   fertility. Herbaceous plants best reduced salinity-alkalinity; trees and
   shrubs excelled in SOM and TN accumulation. Monoculture showed stable
   effects, and longer remediation duration increased salt reduction.
   Remediation duration, plant type, and initial soil pH were core drivers.
   This study provides a scientific basis for optimizing phytoremediation
   strategies under diverse conditions.},
