@article{ WOS:001864084200001,
Author = {Alexandrov, Georgii A.},
Title = {Ecological modelling on its 50th anniversary: A citation analysis of the
   100 most cited papers},
Journal = {ECOLOGICAL MODELLING},
Year = {2026},
Volume = {521},
Month = {NOV},
Abstract = {The journal ``Ecological Modelling{''} was launched to publish papers
   which may be of value to both model developers and model users. The
   number of citations received over the past 50 years demonstrates that
   this intention has been successfully realized. An examination of the 100
   most cited papers sheds some light on the topics most valued by the
   ecological modelling community and suggests that the community's goals
   may shift in the near future - from producing new models to transforming
   them into user-friendly applications that help ecologists derive
   theoretically and practically meaningful insights from the huge amounts
   of data now being collected.},
