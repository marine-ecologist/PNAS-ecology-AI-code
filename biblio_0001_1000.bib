@article{ WOS:001826407600001,
Author = {Noumida, A. and Rajan, Rajeev},
Title = {WavRAN-Wavelet Residual Attention Networks for detecting overlapping
   bird species in field recordings},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {97},
Month = {AUG},
Abstract = {Automatic analysis of bird vocalizations is becoming a powerful tool for
   biodiversity monitoring, conservation efforts, and studying bird
   behavior. In this study, we evaluate Wavelet Residual Attention Networks
   (WavRAN) for identifying multiple bird species from their calls. Our
   approach applies wavelet transforms, including Haar and Mexican-Hat
   wavelets, to mel spectrograms, capturing patterns at different scales.
   These transformed features are then analyzed using a residual
   convolutional neural network with attention mechanisms, which helps the
   model focus on the most informative parts of the bird calls. The
   proposed model, ResCNet+CA, outperformed alternative approaches,
   achieving macro F1-scores of 0.68 and 0.70 for Mexican-Hat and Haar
   wavelet transforms, respectively. By using the Xeno-canto bird sound
   database, this study demonstrates that WavRAN can provide accurate,
   real-time bird identification, offering practical support for ecological
   monitoring, conservation planning, and large-scale biodiversity studies.},
