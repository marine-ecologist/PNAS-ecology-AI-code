@article{ WOS:001367314400001,
Author = {Hu, Yuqing and Si-Moussi, Sara and Thuiller, Wilfried},
Title = {Introduction to deep learning methods for multi-species predictions},
Journal = {METHODS IN ECOLOGY AND EVOLUTION},
Year = {2025},
Volume = {16},
Number = {1},
Pages = {228-246},
Month = {JAN},
Abstract = {Predicting species distributions and entire communities is crucial for
   ecologists, to enhance our understanding of the drivers behind species
   distributions and community assembly and to provide quantitative data
   for conservation efforts. Popular species distribution models use
   statistical and machine learning methods but face limitations with
   multi-species predictions at the community level, hindered by
   scalability and data imbalance sensitivity. This paper explores the
   potential of deep learning methods to overcome these challenges and
   provide more accurate multi-species predictions. Specifically, we
   introduced four distinct deep learning models that use site x species
   community data but differ in their internal structure or on the input
   environmental data structure: (1) a multi-layer perceptron (MLP) model
   for tabular data (e.g. in-situ/raster climate or soil data), (2) a
   convolutional neural network (CNN) and (3) a vision transformer (ViT)
   models tailored for image data (e.g. aerial ortho-photographs, satellite
   imagery), and a multimodal model that integrates both tabular and image
   data. We also show how adapted loss functions can address imbalance
   issues. We applied these deep learning models to a plant community
   dataset comprising 130,582 vegetation surveys encompassing 2522 species
   located in the French Alps. The tabular environmental data consisted of
   climate, terrain and soil information, while the images were derived
   from aerial photographs. All models achieved approximately 70\% true
   skill statistics on hold-out data, demonstrating high predictive
   capacity for community data, the multimodal model being the best
   performing one. Additionally, we showcased how interpretability tools
   can illuminate community structure as seen by deep learning models. Deep
   learning models offer a broad array of features for predicting entire
   species communities. They handle imbalance issues and accommodate
   various data types, from tabular datasets to images, while also being
   equipped with insightful interpretation tools. The versatility extends
   to tabular datasets and images, with no clear superiority between the
   two. The last hidden layers can provide valuable features for modelling
   other species, and the trained models can be used to support transfer
   learning to related tasks. The field of ecology now possesses an
   additional, potent tool in its arsenal that can foster basic and
   fundamental research.
   La pr \& eacute;diction de la distribution des esp \& egrave;ces et des
   communaut \& eacute;s est essentielle pour les \& eacute;cologistes,
   afin d'am \& eacute;liorer notre compr \& eacute;hension des facteurs
   qui sous-tendent la r \& eacute;partition des esp \& egrave;ces et
   l'assemblage des communaut \& eacute;s et de fournir des donn \&
   eacute;es quantitatives pour les efforts de conservation. Les mod \&
   egrave;les de distribution des esp \& egrave;ces utilisent g \& eacute;n
   \& eacute;ralement des m \& eacute;thodes statistiques et
   d'apprentissage automatique, mais se heurtent \& agrave; des limites
   pour les pr \& eacute;dictions multi-esp \& egrave;ces au niveau de la
   communaut \& eacute;, entrav \& eacute;es par l'extensibilit \& eacute;
   et la sensibilit \& eacute; au d \& eacute;s \& eacute;quilibre des donn
   \& eacute;es. Cet article explore le potentiel des m \& eacute;thodes
   d'apprentissage profond pour surmonter ces d \& eacute;fis et fournir
   des pr \& eacute;dictions multi-esp \& egrave;ces plus r \&
   eacute;alistes. Plus pr \& eacute;cis \& eacute;ment, nous introduisons
   quatre diff \& eacute;rents mod \& egrave;les d'apprentissage profond
   qui utilisent des donn \& eacute;es sur les communaut \& eacute;s d'esp
   \& egrave;ces (sites x esp \& egrave;ces) mais qui diff \& egrave;rent
   par leur structure interne ou par la structure des donn \& eacute;es
   environnementales d'entr \& eacute;e: (1) un mod \& egrave;le de
   perceptron multicouche (MLP) pour les donn \& eacute;es tabulaires (par
   exemple, des donn \& eacute;es climatiques ou p \& eacute;dologiques
   mesur \& eacute;es in situ ou sous forme de raster), (2) un r \&
   eacute;seau de neurones convolutif (CNN) et (3) un vision transforer
   (ViT) adapt \& eacute;s aux donn \& eacute;es sous forme d'image (par
   exemple, orthophotos a \& eacute;riennes, images satellitaires), et un
   mod \& egrave;le multimodal qui int \& egrave;gre \& agrave; la fois les
   donn \& eacute;es tabulaires et les donn \& eacute;es d'image. Nous
   montrons \& eacute;galement comment des fonctions de perte adapt \&
   eacute;es peuvent r \& eacute;soudre les probl \& egrave;mes de d \&
   eacute;s \& eacute;quilibre. Nous avons appliqu \& eacute; ces mod \&
   egrave;les d'apprentissage profond sur des donn \& eacute;es de
   communaut \& eacute;s v \& eacute;g \& eacute;tales comprenant 130,582
   relev \& eacute;s de v \& eacute;g \& eacute;tation et 2522 d'esp \&
   egrave;ces situ \& eacute;es dans les Alpes fran \& ccedil;aises. Les
   donn \& eacute;es environnementales tabulaires comprenaient des
   informations sur le climat, le terrain et le sol, tandis que les images
   provenaient de photographies a \& eacute;riennes. Tous les mod \&
   egrave;les ont atteint environ une True Skill Statistics de 70\% sur les
   donn \& eacute;es d'\& eacute;valuation , d \& eacute;montrant une
   grande capacit \& eacute; de pr \& eacute;diction pour les donn \&
   eacute;es de communaut \& eacute;es, le mod \& egrave;le multimodal \&
   eacute;tant le plus performant. En outre, nous montrons comment les
   outils d'interpr \& eacute;tabilit \& eacute; peuvent \& eacute;clairer
   la structure de la communaut \& eacute; telle qu'elle est per \&
   ccedil;ue par les mod \& egrave;les d'apprentissage profond. Les mod \&
   egrave;les d'apprentissage profond offrent donc un large \&
   eacute;ventail de caract \& eacute;ristiques pour pr \& eacute;dire des
   communaut \& eacute;s d'esp \& egrave;ces dans leur ensemble. Ils g \&
   egrave;rent les probl \& egrave;mes de d \& eacute;s \& eacute;quilibre
   et s'adaptent \& agrave
   Les derni \& egrave;res couches cach \& eacute;es peuvent fournir des
   caract \& eacute;ristiques pr \& eacute;cieuses pour la mod \&
   eacute;lisation d'autres esp \& egrave;ces, et les mod \& egrave;les
   form \& eacute;s peuvent \& ecirc;tre utilis \& eacute;s pour soutenir
   l'apprentissage par transfert vers des t \& acirc;ches connexes. Le
   domaine de l'\& eacute;cologie dispose d \& eacute;sormais d'un outil
   suppl \& eacute;mentaire et puissant dans son arsenal, qui peut
   favoriser la recherche fondamentale.},
