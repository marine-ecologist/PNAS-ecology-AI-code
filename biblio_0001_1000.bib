@article{ WOS:001781378000001,
Author = {Ferreira, Ana Paula and da Silva, Alexandre R.},
Title = {House of the blue dragon: Ecological niche models predict range
   expansion of Glaucus atlanticus Forster, 1777 (Mollusca:
   Nudibranchia) under different climate change scenarios},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
Year = {2026},
Volume = {98},
Month = {JUN},
Abstract = {Climate change poses critical challenges to marine biodiversity,
   particularly through shifts in environmental variables that define
   species distributions. This study investigates how the distribution of
   Glaucus atlanticus, a neustonic nudibranch with a global but fragmented
   range, may change under future climate scenarios using ecological niche
   modeling (ENM). We utilized occurrence data and 15 oceanographic
   variables, selected through variance inflation factor (VIF) analysis, to
   calibrate Random Forest models via the sdm R package. The models showed
   high evaluation scores (AUC = 0.97; TSS = 0.87), and environmental
   predictors such as pH, phytoplankton concentration, ocean temperature,
   and dissolved oxygen were the most influential. Future projections under
   two Shared Socioeconomic Pathways (SSP2-4.5 and SSP5-8.5) for the
   periods 2040-2050 and 2090-2100 showed a potential poleward expansion of
   the species' distribution, particularly under the high-emission SSP5-8.5
   scenario. Our results suggest that climate-driven changes may increase
   environmental suitability at higher latitudes while reducing suitability
   in equatorial zones. This expansion might alter local food webs by
   introducing a new predator, potentially causing trophic disruptions. The
   findings highlight the role of G. atlanticus as a sentinel species for
   understanding the restructuring of marine ecosystems in a warming world
   and emphasize the need to incorporate both abiotic and biotic factors in
   future ENM studies.},
