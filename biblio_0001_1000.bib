EISSN = {2041-2096},
Keywords = {modelling; spatial or time-series; statistics; upscaling},
Keywords-Plus = {SENSITIVITY-ANALYSIS; SCALE; DYNAMICS; DESIGN; SOIL},
Research-Areas = {Environmental Sciences \& Ecology},
