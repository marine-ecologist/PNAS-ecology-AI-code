Language = {English},
Affiliation = {Rossi, C (Corresponding Author), Univ Politecn Madrid, Ctr Automat \& Robot, CSIC, Madrid 28006, Spain.
   Ruiz, M. Roman; Rossi, C., Univ Politecn Madrid, Ctr Automat \& Robot, CSIC, Madrid 28006, Spain.
