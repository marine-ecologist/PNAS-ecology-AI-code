@article{ WOS:001780904000001,
Author = {Liu, X. and Hong, C. K.},
Title = {DIGITAL HUMANITIES IN ENVIRONMENTAL COLOR ART: PREDICTIVE STRATEGIES
   DESIGNED FOR INNOVATION IN FOREST ECOSYSTEM CONSERVATION IN RESPONSE TO
   GLOBAL WARMING},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {5109-5128},
Abstract = {Climate change increasingly threatens forests worldwide through
   unprecedented environmental stresses and disturbances. To conserve
   species, we need to develop innovative strategies that integrate new
   tools and management approaches. This study combines new concepts from
   the digital humanities and environmental color art analytics to conserve
   forest ecosystems in ways that remain effective as the climate changes.
   CIE Lab color space used to identify where the signs of early-stage
   plant stress appear on images from Landsat-8 and Sentinel-2 collected at
   different times during the period 2019-2024. The study employed the
   Color Vegetation Index (CVI) and a hybrid Random Forest-LSTM model,
   which performed effectively in predicting forest health across all
   datasets. The multi-criteria decision analysis considered both
   environmental and cultural factors. The protected areas currently in
   place will not be enough after 2050. If climate change becomes
   particularly severe (RCP 8.5 scenario), this means that by 2050, an
   additional 52\% of the total area will need to be protected. The
   proposed approach effectively integrates quantitative ecological
   assessment and qualitative cultural considerations. It provides useful
   insights into forest management approaches that remain relevant under
   changing conditions. As climate change intensifies, these regulations
   safeguard natural habitats, support wildlife, and ensure the long-term
   health of ecosystems.},
