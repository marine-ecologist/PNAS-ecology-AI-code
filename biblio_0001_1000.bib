@article{ WOS:001866409500001,
Author = {Timmermans, Anna and Marais, Marc},
Title = {Similarity learning network using quadruplet loss for animal
   re-identification},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {99},
Month = {NOV},
Abstract = {Animal re-identification is a computer vision task that focuses on
   identifying specific individuals within images or videos. Recent machine
   learning systems developed for this task rely on models that can
   sufficiently distinguish the unique features of individual animals. This
   task is further complicated by the requirement to re-identify animals
   over time spans and across multiple species, which necessitates a model
   design with even greater discriminative capability. To address the
   problem, this paper explores three Convolutional Neural Networks
   backbone architectures, VGG19, ResNet50, and MobileNet, in combination
   with Triplet and Quadruplet loss functions. Data was split under both
   random and time-aware closed-set protocols. Experiments are conducted on
   four sea turtle datasets: SeaTurtleID2022, SeaTurtleIDHeads,
   AmvrakikosTurtles, and ReunionTurtles. On the single-species
   SeaTurtleID2022 dataset, MobileNet with Quadruplet loss achieved the
   highest performance, reaching a top-1 accuracy of 68.10\% and top-5
   accuracy of 85.13\% on the random split, and 59.92\% and 78.46\%,
   respectively, on the more ecologically realistic time-aware split. This
   is competitive with the transformer-based Swin-B model with ArcFace loss
   on the same dataset. When applied to multi-species re-identification,
   the model achieved an overall top-1 accuracy of 71.66\% and top-5
   accuracy of 77.22\%. These results demonstrate that lightweight CNN
   architectures with Quadruplet loss are a competitive and computationally
   efficient alternative to existing transformer-based models for sea
   turtle re-identification, with potential for deployment in
   resource-constrained conservation settings. The trained model for the
   combined random dataset weights and implementation details are publicly
   available at: https://huggingface.
   co/marcmarais-ru/seaturtle\_reid\_mobilenetv2-quadruplet-random-combined
   \_datasets.},
