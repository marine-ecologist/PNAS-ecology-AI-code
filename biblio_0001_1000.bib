@article{ WOS:000172908000002,
Author = {Dollhopf, SL and Hashsham, SA and Tiedje, JM},
Title = {Interpreting 16S rDNA T-RFLP data: Application of self-organizing maps
   and principal component analysis to describe community dynamics and
   convergence},
