@article{ WOS:001784954300001,
Author = {Cherif, Yousra and Idri, Ali},
Title = {Evaluating ensemble-based filters and wrappers for biodiversity
   conservation},
Journal = {JOURNAL FOR NATURE CONSERVATION},
Year = {2026},
Volume = {93},
Month = {SEP},
Abstract = {Species Distribution Models (SDMs) are widely used to analyze
   relationships between environmental variables and species occurrences,
   supporting ecological applications such as habitat suitability
   assessment, niche modeling, and conservation planning. However, the high
   dimensionality and redundancy of environmental data can negatively
   affect model performance and interpretability. To address this issue,
   this study aims to evaluate and compare single and ensemble feature
   selection techniques for species distribution modeling. Several
   approaches are investigated, including univariate and multivariate
   filters as well as wrapper methods. In addition, fusion- and
   intersection-based ensembles, along with filter ensembles based on Borda
   Count and Reciprocal Rank, are assessed using four classifiers: Extreme
   Gradient Boosting, Random Forest, Decision Tree, and Light Gradient
   Boosting Machine. Results indicate that Sequential Feature Selection
   achieved the best overall performance among single methods, while Fisher
   Score combined with Random Forest was the most efficient in terms of
   feature reduction. Furthermore, ensemble approaches generally
   outperformed individual methods, with Reciprocal Rank emerging as the
   most effective filter-based ensemble. In addition, the most relevant
   features selected by SFS were: bio3 (Isothermality), bio7 (Temperature
   Annual Range), bio13 (Precipitation of Wettest Month), and bio19
   (Precipitation of Coldest Month) and the most relevant features selected
   by SFS were: bio7 (Temperature Annual Range), bio15 (Precipitation
   Seasonality), bio11 (Mean Temperature of Coldest Quarter), bio18
   (Precipitation of Warmest Quarter), and bio1 (Annual Mean Temperature)},
