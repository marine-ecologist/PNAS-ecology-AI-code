@article{ WOS:001854803400001,
Author = {Wang, Fan and Liu, Qin and Wang, Ziyu and Lv, Hong and Wang, Huiliang},
Title = {Nonlinear hydroclimatic associations and LULC-based spatial consistency
   assessment of vegetation dynamics in the Tarim River Basin},
Journal = {JOURNAL OF ARID ENVIRONMENTS},
Year = {2026},
Volume = {237},
Month = {AUG},
Abstract = {Understanding vegetation dynamics and their associations with
   hydroclimatic variability and non-climatic residual components is
   important for ecological management and water resource regulation in
   arid inland river basins. Traditional residual-based attribution methods
   often rely on linear climate baselines and may overinterpret unexplained
   residuals as direct anthropogenic effects. Taking the Tarim River Basin
   as a case study, this study integrated multi-source remote sensing,
   climate, and land-use/land-cover (LULC) data from 2001 to 2024.
   Theil-Sen trend analysis, Mann-Kendall classification, and the Hurst
   index were used to evaluate NDVI dynamics and persistence. A nonlinear
   Random Forest (RF) model was used to construct a statistical
   climate-associated NDVI baseline, and LULC transitions were introduced
   to assess the spatial consistency of non-climatic residual-dominated
   vegetation changes. The results showed that: (1) NDVI increased at a
   rate of 0.0123 per decade, with improvements mainly distributed in
   northern mountainous areas, oasis margins, and river corridors; (2)
   historical greening may persist in many mountain-oasis systems, whereas
   some oasis-desert transition zones showed potential instability; (3)
   soil moisture was the most important hydroclimatic predictor; and (4)
   ecological restoration, agricultural expansion, and agricultural
   intensification were spatially associated with part of the
   residual-dominated greening signal.},
