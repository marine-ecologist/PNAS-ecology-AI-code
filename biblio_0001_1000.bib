@article{ WOS:001753466600001,
Author = {Zou, Zheng and Shi, Wen-Wen and Liu, Shi-Jian and Wang, Ding-Yi and
   Fang, Hong-Yi},
Title = {Deep learning-based keypoint detection for morphological measurement of
   termite legs with potential occlusion},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {95},
Month = {MAY},
Abstract = {Termite leg morphology is crucial for analyzing their ecological
   adaptation and species classification, but manual measurement is
   inefficient, subjective, and poor at handling occlusions. This study
   proposes MK-HRNet, a deep learning model for automated termite leg
   keypoint detection, which enabling precise measurement of termite leg
   morphology even under occlusion scenarios. MK-HRNet is built on HRNet,
   with three key improvements: a multi-scale dilated convolution fusion
   module for hierarchical feature extraction, a novel loss function to
   ensure keypoint accuracy and valid leg length prediction, and artificial
   occlusion data synthesis to boost occlusion robustness. Experiments on a
   custom termite dataset show MK-HRNet outperforms stateof-the-art models
   in key metrics, thereby offering a reliable solution for automated
   morphological analysis in entomology.},
