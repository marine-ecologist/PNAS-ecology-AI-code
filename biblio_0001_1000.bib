@article{ WOS:001571592000007,
Author = {Obolewski, Krystian},
Title = {Can artificial intelligence help develop next-generation biomonitoring
   for aquatic ecosystems?},
Journal = {ECOHYDROLOGY \& HYDROBIOLOGY},
Year = {2025},
Volume = {25},
Number = {3},
Pages = {700-704},
Month = {JUL},
Abstract = {One challenge in ecological research is the continuous need to collect
   sufficient sets of large-scale, precise data to allow the error-free
   detection and counteracting of unfavourable global change processes. The
   major obstacle is the time-consuming and challenging process of sorting
   and identifying organisms. However, the role of artificial intelligence
   (AI) as a tool for biodiversity observation is more than just a
   potential solution - - it is a beacon of hope. Among the large group of
   bioindicators of aquatic environments, benthic macroinvertebrates, which
   includes very diverse insects, play an essential role. The costly and
   time-consuming process of species identification (both traditional and
   molecular) has been a critical obstacle to implementing next-generation
   biomonitoring (NGB) of aquatic ecosystems. But now, improved methods
   have been proposed for microscopic identification (e. g., of species of
   chironomid larvae, Diptera) based on deep learning from information
   available in public databases. Transfer learning is implemented using a
   deep convolutional neural network (CNN), which is then trained on a set
   of many photos of larvae. This breakthrough enables us to facilitate the
   assessment of the species composition of this insect group, with the aim
   of determining the quality of the environment. Thanks to this, the use
   of AI in traditional taxonomic research is set to complement molecular
   methods (DNA barcoding and/or metabarcoding) in implementing NGB. Such
   an approach should become increasingly popular in the coming years,
   especially in implementing biodiversity protection strategies based on
   detailed knowledge about the species diversity of ecosystems on a large
   spatial scale.},
