@article{ WOS:001707796800001,
Author = {Hidayat, Muhammad Yafie Rachmat Rizky and Tong, Jianfeng and Kasim, Nur
   Ainul Hidayat},
Title = {Machine learning enhanced ecoacoustic indices for coral reef species
   richness prediction in noise-impacted soundscapes},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
Year = {2026},
Volume = {96},
Month = {APR},
Abstract = {Traditional biodiversity monitoring of coral reefs is resource-intensive
   and spatially limited. This study investigates whether passive acoustic
   monitoring (PAM), combined with machine learning (ML), can offer an
   efficient and accurate method to predict coral reef species richness in
   dynamic coastal environments. The research was conducted at four
   ecologically distinct reef sites around Panambungan Island, Indonesia,
   to assess the feasibility of using underwater soundscapes as a proxy for
   biodiversity. High-frequency and standard hydrophones recorded
   soundscapes at each site over a three-week period. Ecoacoustic indices,
   including Temporal Entropy, Spectral Entropy, and the Acoustic
   Complexity Index (ACI), were computed to characterize acoustic patterns.
   These indices were used as features in a Random Forest model to predict
   visually surveyed species richness. Ecoacoustic indices such as Temporal
   Entropy and Spectral Entropy were analyzed to characterize the
   complexity of underwater sounds. This study tested the accuracy of
   machine learning in predicting coral reef species richness using
   acoustic data. The results showed that Acoustic Complexity Index (ACI)
   was failing to serve as a statistically significant proxy for biological
   species richness in the presence of dominant low-frequency vessel noise.
   In contrast, a Random Forest model trained on noise-filtered acoustic
   features (e.g., entropy indices excluding dominant vessel-noise bands)
   initially achieved high classification accuracy (similar to 95\%) under
   random cross-validation. However, when evaluated using strict
   spatial-temporal blocked validation to control for temporal
   autocorrelation, the model retained robust performance (similar to
   87.5\%) in categorizing reef sites by species-richness level. These
   findings highlight the necessity of integrating targeted soundscape
   analysis with traditional ecological surveys.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Tong, JF (Corresponding Author), Shanghai Ocean Univ, Coll Marine Living Resource Sci \& Management, Shanghai 201306, Peoples R China.
   Hidayat, Muhammad Yafie Rachmat Rizky; Tong, Jianfeng; Kasim, Nur Ainul Hidayat, Shanghai Ocean Univ, Coll Marine Living Resource Sci \& Management, Shanghai 201306, Peoples R China.
