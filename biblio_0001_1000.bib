@article{ WOS:001732698800002,
Author = {Alghamdi, Wajdi and Ali, Farman and Algarni, Abdulmohsen and
   Alghushairy, Omar and Khalid, Majdi and Du, Meng-Ze},
Title = {DeepPFT-GANCap: An explainable attention-based hybrid deep learning
   framework integrating protein language models and wavelet
   denoising-based evolutionary features for photosystem-II core protein
   prediction},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {95},
Month = {MAY},
Abstract = {Functional traits of plants are key to the study of ecological
   processes, adaptations of species, and the responses of ecosystems to
   alterations of the environment. Particularly, the Photosystem-II core
   protein (P-IICP) is vital for a plant's adaptability and efficiency of
   photosynthesis in several environments. The intricacy of
   sequencefunction relations and the scope of conventional computational
   methods are hurdles in the precise characterization and prediction of
   such proteins. We propose an attention-based hybrid deep learning (DL)
   framework, DeepPFT-GANCap, which integrates attention mechanisms with
   Generative Adversarial Network, Capsule Network, and Bidirectional
   Temporal Convolutional Neural Network. Using advanced protein language
   models (ProtTrans-T5, UniRep, and ESM-2) in conjunction with a novel
   Discrete Cosine Transform-based evolutionary descriptor (PsePSSM-DCT)
   allows our model to extract highly discriminative features. To improve
   interpretability, we utilized a wrapper-based XGBoost-Forward Feature
   Selection (XGB-FFS) approach. The experimental results of DeepPFT-GANCap
   demonstrated consistently superior performance compared to competing
   predictors, exhibiting higher accuracy and good generalization across
   both training and independent test datasets, thereby validating the
   effectiveness of the proposed system. The SHapley Additive exPlanations
   (SHAP) analysis revealed the most influential features contributing to
   model predictions, emphasizing the critical functional role of P-IICP in
   photosynthesis and ecosystem monitoring. The study provides a scalable
   computational framework with advanced interpretability for monitoring
   plant functional traits to drive the science of trait-based ecology and
   the interaction of climate with ecosystems.},
