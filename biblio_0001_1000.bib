@article{ WOS:001780904500001,
Author = {Zhang, Y. F. and Lee, L.},
Title = {KEY TECHNIQUES FOR REGIONAL ECONOMIC-ECOLOGICAL FUNCTION ZONING BASED ON
   SOFM AND RANDOM FOREST},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {5247-5266},
Abstract = {Regional economic-ecological function zoning plays an important role in
   the long-term development of a region. It can more accurately reflect
   the ecological and economic characteristics of the area as well as its
   advantages and disadvantages, which is beneficial for promoting
   sustainable regional economic development. However, traditional
   techniques for regional economic-ecological function zoning often rely
   on manual operations and consume a large amount of human and material
   resources. To address this issue, this study raises a regional
   economic-ecological function zoning algorithm that integrates
   Self-Organizing Feature Map network and Random Forest. The algorithm
   fully combines the advantages of the Self-Organizing Feature Map network
   and Random Forest algorithm through two aspects: regional clustering and
   determination of dominant functions. Experimental results show that the
   proposed integrated algorithm achieves the best clustering effect, and
   when the sample size is below 800, all the clusters formed are valid.
   Moreover, the zoning accuracy of the algorithm reaches 97.82\% after
   iteration, and the Kappa index reaches 83.82\%. In practical
   application, the algorithm shows slow memory growth, with a maximum
   memory usage of 804.5 MB. When the data size is 1500, the response time
   is only 60.8 s, and five indicators of zoning results match the real
   situation above 92\%, demonstrating good zoning performance. Overall,
   the proposed regional economic-ecological function zoning algorithm
   effectively overcomes the limitations of traditional techniques and
   algorithms, providing valuable reference for related fields.},
