@article{ WOS:001814970400001,
Author = {Ren, B. Q. and Yang, Z. Q.},
Title = {WAVELET TRANSFORM AND GRAPH NEURAL NETWORK-BASED ALGORITHM FOR MARINE
   ECOLOGICAL ENVIRONMENT CHANGE DETECTION USING MULTI-SOURCE REMOTE
   SENSING IMAGES},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {4},
Pages = {7043-7057},
Abstract = {When detecting changes in the marine ecological environment,
   multi-source remote sensing data are heterogeneous, complex in spatial
   correlation and prone to miss detection of weak signals. In order to
   solve these problems, this article presents a cooperative detection
   algorithm which combines wavelet transform and graph neural network. In
   the study, discrete wavelet transform is used to decompose the image at
   multiple scales, and a high-frequency detail weighted fusion strategy is
   constructed to enhance the abnormal water body structures. Then,
   according to the spatial proximity and prior of the ocean flow field,
   the graph structure is dynamically constructed, and an attention network
   is designed to realize the node feature aggregation. Finally, the
   experiment was carried out in the red tide high-incidence area of the
   East China Sea (28 degrees N-32 degrees N, 122 degrees E-126 degrees E).
   The results show that the F1-score of the proposed method reaches 0.862
   on the test set, and the recall rate is 0.831, which is significantly
   superior to traditional unsupervised models (principal component
   analysis combined with K-means, F1=0.635) and mainstream deep learning
   baseline models (Siamese convolutional neural network, wavelet transform
   combined with fully convolutional network, graph neural network-only).
   The model can still maintain high robustness in scenes with a time
   interval exceeding 15 days. It is proved that the combination of
   multi-scale features in wavelet domain and spatial reasoning ability of
   graph neural network can effectively improve the accuracy and
   practicability of marine ecological change detection.},
