@article{ WOS:000947043300001,
Author = {Gomez-Gomez, Joan and Vidana-Vila, Ester and Sevillano, Xavier},
Title = {Western Mediterranean Wetland Birds dataset: A new annotated dataset for
   acoustic bird species classification},
