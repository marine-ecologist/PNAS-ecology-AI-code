@article{ WOS:001838390900001,
Author = {Lu, M. Z.},
Title = {ADAPTIVE EVALUATION SYSTEM FOR ECOLOGICAL LANDSCAPE DESIGN BASED ON
   MULTI-SOURCE DATA},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {4},
Pages = {7813-7841},
Abstract = {Ecological landscape design (ELD) is a key approach for enhancing urban
   sustainability through biodiversity conservation, stormwater management,
   and the mitigation of urban heat islands. Conventional evaluation
   methods rely on static indicators and limited datasets, reducing their
   ability to capture the dynamic and complex interactions within
   ecological systems. An Adaptive Evaluation System for ELD has been
   developed to overcome these limitations by integrating diverse
   environmental, ecological, and sociospatial datasets within a dynamic,
   data-driven framework. The adaptive ecological landscape dataset
   incorporates meteorological and social datasets obtained from IoT
   sensors, and open-access repositories. Principal Component Analysis
   (PCA) was employed for feature extraction, reducing dimensionality while
   retaining critical ecological indicators. The evaluation process was
   powered by a Battle Royale Optimized Attention Spiking Neural Network
   (BRO-ASNN), which combines the temporal learning capacity of spiking
   neural networks (SNN) with a Battle Royale-inspired optimization
   mechanism to improve adaptive learning, factor weighting, and
   decision-making. The findings show that the BRO-ASNN with accuracy,
   F1-score, recall, and precision ranging from 96\% to 99\%, the ASNN
   technique outperforms multimodal baseline designs and produces superior
   results. The proposed system provides a scalable, transferable framework
   for ecological landscape planning, enhancing sustainable urban
   development.},
