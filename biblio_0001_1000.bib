@article{ WOS:001815125100001,
Author = {Roman, Pablo Refoyo and Esteban, Elena Herrero and Garcia-Deltell,
   Adrian and Alia, Teresa and Salinas, Cristina Olmedo},
Title = {Climatic suitability index: A useful tool for amphibian conservation},
Journal = {GLOBAL ECOLOGY AND CONSERVATION},
Year = {2026},
Volume = {69},
Month = {SEP},
Abstract = {Climate change is one of the main drivers influencing biodiversity loss,
   and amphibians are a taxon highly vulnerable to its effects, making it
   one of the main causes of their current decline. Understanding the
   climatic variables that influence their distribution is essential for
   their conservation. We analyzed 23 amphibian species from mainland Spain
   using presence data (UTM 10X10km grid) and assessed the relative
   importance of 19 climatic variables (WorldClim) using the Random Forest
   algorithm. After ranking these variables, a binomial generalized linear
   model was used to calculate the Climate Suitability Index (CSI) for each
   species. By averaging these indexes, we then derived the Amphibian
   Climatic Suitability Index (ACSI) for mainland Spain. These indexes
   weight the value of each variable in the species' distribution and they
   can facilitate the simultaneous calculation of suitable habitat for
   amphibians in peninsular Spain across multiple climate scenarios. The
   mean temperature of the wettest quarter (BIO8) and the precipitation
   seasonality (BIO15) are the most influential predictors. Temperature
   variables were more important for 16 species, whereas precipitation
   variables had a stronger influence on 15 species. Based on the overall
   ACSI, the climatically suitable area for amphibians is projected to
   decrease by 89\%. Under the 2100 climate scenario, 14 species are
   expected to lose suitable area, while nine species are projected to
   expand their distribution northwards. Our suitability models allow the
   prediction of how different climate scenarios may affect each amphibian
   species, thereby supporting the development of conservation strategies
   through targeted monitoring of temperature and precipitation.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
