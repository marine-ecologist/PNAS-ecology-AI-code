@article{ WOS:001849193400001,
Author = {da Silva, Lucas Goncalves and Elias, Marco Aurelio Mendes and dos
   Santos, Juliana Silveira and Jacomo, Anah Tereza de Almeida and Santos,
   Douglas and Neto, Ennio Painkow and Soares, Fabio Hudson Souza and de
   Carvalho, Gabriel Caputo and Alves, Giselle Bastos and Barquero, Gonzalo
   and Perfeito, Igor Fagundes and de Carvalho, Marina Motta and Santos,
   Rodrigo Augusto Lima and Nomiyama, Thiago Silvestre and Goncalves,
   Angelica Beatriz Correa and Belem, Joao Vitor Franco Benjamim and
   Guimaraes, Sebastiao Pegoraro Monteiro and Torres, Natalia Mundim and
   Diniz-Filho, Jose Alexandre and de Paula, Wlainer and Silveira, Tiago
   Jacomo and Silveira, Leandro},
Title = {Collaborative monitoring networks refine jaguar habitat suitability and
   reveal conservation gaps in the Brazilian Cerrado},
Journal = {BIOLOGICAL CONSERVATION},
Year = {2026},
Volume = {322},
Month = {OCT},
Abstract = {Habitat loss and fragmentation threaten wide-ranging carnivores
   worldwide, particularly in rapidly transforming tropical savannas. The
   jaguar (Panthera onca) persists in the Brazilian Cerrado, a central
   South American savanna covering approximately 2 million km2, where
   suitable habitats are increasingly embedded within agricultural and
   privately managed landscapes. We developed ensemble species distribution
   models to evaluate jaguar habitat suitability across the Cerrado by
   integrating traditional research records with expert-validated data from
   a collaborative monitoring network operating largely on private lands.
   Ensemble models combined four algorithms: Artificial Neural Networks,
   Generalized Boosted Models, Random Forest, and Maximum Entropy. A total
   of 635 occurrence records were compiled between 2010 and 2025, of which
   480 were retained after 10-km spatial filtering to reduce clustering
   effects. Models showed high discriminatory performance, and the
   inclusion of collaborative records expanded predicted suitability into
   agricultural matrices and peripheral regions that were underrepresented
   by traditional datasets alone. Spatial overlap analyses showed that
   75.75\% of occurrence records occurred outside Protected Areas, with
   collaborative records being proportionally more frequent in unprotected
   landscapes. Land-cover analyses further indicated that predicted
   suitable habitat included native vegetation (49.55\%), pasture
   (24.56\%), agriculture (13.99\%), and mosaic agriculture-pasture areas
   (8.55\%). These results should be interpreted as patterns of predicted
   habitat suitability and spatial congruence, rather than direct evidence
   of functional connectivity. Our findings highlight the value of
   expert-validated collaborative monitoring for reducing geographic
   knowledge gaps and improving spatial conservation assessments for large
   carnivores in fragmented tropical savannas.},
