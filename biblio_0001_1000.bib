@article{ WOS:001791276000001,
Author = {Anaba, Clement Issaka and Addaney, Michael and Kabo-bah, Amos Tiereyangn
   and Moomen, Abdul-Wadood},
Title = {Urban sprawl and wetland loss in Dormaa, Ghana: causal drivers and
   cascading climate risks},
Journal = {URBAN ECOSYSTEMS},
Year = {2026},
Volume = {29},
Number = {4},
Month = {JUN 11},
Abstract = {Urban expansion in secondary African cities increasingly drives wetland
   degradation and loss, yet the causal mechanisms, spatial patterns, and
   climate risks remain poorly quantified. Using Landsat imagery and Random
   Forest, we addressed this gap by analysing three decades (1994-2024) of
   land-use change. We applied Convergent Cross Mapping (CCM) and its
   geographical extension (GCCM) to establish causal linkages between
   wetland decline and its drivers in Dormaa Central Municipality, Ghana.
   Future trajectories to 2054 are simulated using a Cellular
   Automata-Artificial Neural Network (CA-ANN) model coupled with ensemble
   climate projections. Built-up expansion emerged as the strongest causal
   driver of wetland decline (rho approximate to = -0.90), followed by
   rising land surface temperature, while precipitation and forest cover
   support wetland persistence. Wetland area decreased by 62.7\% (from
   72.00 km \& sup2; in 1994 to 26.76 km \& sup2; in 2024), while built-up
   land increased by 171\% (from 100.24 km \& sup2; to 271.85 km \& sup2;
   within the same period). Field validation confirmed direct conversion,
   infilling, and pollution as key degradation processes. Under a
   business-as-usual scenario, wetlands are projected to decline by a
   further 25\% by 2054, which might amplify urban heat island (UHI)
   intensity by up to 3.0 degrees C in central urban zones and increase
   flood risk in former wetland basins. These changes are projected to
   significantly increase cooling energy demand and heat-related health
   risks. The findings underscore that wetland loss in secondary cities is
   not merely an ecological concern but also a key threat to urban climate
   resilience, calling for spatially targeted policies that integrate
   wetlands as essential blue-green infrastructure into land-use and
   climate-adaptation planning.},
