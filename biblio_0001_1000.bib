@article{ WOS:001825263400001,
Author = {Lee, Jae-Ho and Shin, Man-Seok and Lee, Jae-Seok and Seo, Chang-Wan},
Title = {National-scale random forest forecasts of endangered freshwater fish
   distributions and climate refugia under SSP scenarios in South Korea},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {97},
Month = {AUG},
Abstract = {Freshwater fishes with narrow geographic ranges are increasingly exposed
   to climate warming and river regulation, yet decision-relevant
   national-scale forecasts of future habitat suitability, richness
   patterns, and refugia remain limited. Here, we developed an
   ecoinformatics workflow to predict the current and future distributions
   of 26 endangered freshwater fish species in South Korea using Random
   Forest species distribution models (SDMs) and harmonized 1 km
   environmental layers. Models were trained with occurrence records from
   nationwide surveys and protected-area monitoring and linked to 10
   predictors, including six bioclimatic variables (BIO1, BIO2, BIO3,
   BIO12, BIO13, BIO14), elevation, slope, distance to river, and a wetness
   index. Future projections were generated for the 2030s, 2050s, 2070s,
   and 2090s under SSP2-4.5 and SSP5-8.5. Predictive skill assessed by
   stratified five-fold cross-validation was high across species (mean AUC
   = 0.952, mean TSS = 0.843, mean Kappa = 0.689). Across models,
   isothermality (BIO3), distance to river, mean annual temperature (BIO1),
   and precipitation of the driest month (BIO14) were the most influential
   predictors. Stacked SDM outputs showed that current richness hotspots
   were concentrated in upstream mountainous river networks and protected
   landscapes, whereas future projections indicated scenario-dependent
   contraction, fragmentation, and spatial reorganization of high-richness
   areas, with stronger late-century reductions under SSP5-8.5. Patch-based
   fragmentation analysis further showed that hotspot areas became
   increasingly subdivided and spatially restricted under stronger climate
   forcing. Persistent high-suitability clusters in cold, high-elevation
   headwaters were identified as candidate refugia-like areas. These
   results provide a transparent, spatially explicit framework for
   comparing regional freshwater fish richness patterns and identifying
   priority areas for climate-adaptive conservation planning in South
   Korea.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Seo, CW (Corresponding Author), Natl Inst Ecol, Seocheon 33657, South Korea.
   Lee, Jae-Ho; Shin, Man-Seok; Seo, Chang-Wan, Natl Inst Ecol, Seocheon 33657, South Korea.
   Lee, Jae-Seok, Konkuk Univ, Biol Sci, Seoul 05029, South Korea.},
