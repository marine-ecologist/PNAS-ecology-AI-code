@article{ WOS:001751513300001,
Author = {Derakhshan-Babaei, Farzaneh and Boloorani, Ali Darvishi and Mirghaed,
   Farhan Ahmadi and Alavi, Seyed Jalil and Arami, Seyed Hossein and
   Hadarbadi, Gholamreza and Collins, Adrian L.},
Title = {Effects of land abandonment on soil quality and erosion risk: A
   multi-criteria evaluation and machine learning approach},
Journal = {ECOLOGICAL ENGINEERING},
Year = {2026},
Volume = {228},
Month = {JUL},
Abstract = {Agricultural land abandonment (ALA) is one environmental issue that can
   affect soil quality (SQ) and erosion risk (ER), especially in semi-arid
   regions. This study aimed to assess SQ and ER in abandoned and
   cultivated lands in the Khuzestan Plain, southwestern Iran. SQ was
   evaluated using the Random Forest method and ER was assessed using
   spatial multi-criteria decision-making models. The study found that the
   soils in the region were of low to moderate quality. The higher quality
   soils were predominantly located in the northern and northeastern parts,
   which are primarily covered by highland cultivation. Lower quality soils
   were found in the central parts, which were mainly comprised abandoned
   lands. The highest erosion risk was observed in the high and steep areas
   of the eastern and southeastern parts, which are mainly abandoned lands.
   The lowest erosion risk was observed in the low-slope parts of the
   region, which primarily comprise cultivated lands. Correlation analyses
   clarified that SQ was more closely related to topographic factors than
   others. It directly correlated with elevation, slope, and TRI (0.57 < R
   < 0.81, P-value<0.05) and inversely with valley depth (R = -0.66,
   P-value<0.05). ER had a positive relationship with slope (R = 0.70,
   P-value<0.05) and an inverse relationship with vegetation (R = -0.34,
   P-value<0.05). Cultivated lands had higher quality soils than abandoned
   lands, but the opposite was true for erosion risk. This study revealed
   that the ALA can affect SQ and ER due to soil degradation and worsening
   ecological conditions. Hence, it is essential to implement land
   management strategies and develop appropriate programs to protect soil,
   reduce erosion risk, and prevent land abandonment in semi-arid regions.},
