@article{ WOS:001852764600001,
Author = {Zimmermann, Grasielli Barreto and Pellenz, Marcelo Eduardo and Costa,
   Denis Santiago da and Britto Jr, Alceu de Souza and Navarro, Luan Samuel
   and Teixeira, Marco Antonio Simoes},
Title = {An ML-based approach for ecological restoration: Species selection and
   successional planting design},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {98},
Month = {SEP},
Abstract = {Traditional forest restoration planning often relies on manual curation
   of vast silvicultural literature, a process that is time-consuming and
   prone to subjective bias. This paper proposes a hybrid computational
   framework that integrates expert-driven ecological scoring with Machine
   Learning (ML)-based knowledge emulation to support species selection and
   planting design. Using a curated dataset derived from historical
   silvicultural manuals, the system employs Term Frequency-Inverse
   Document Frequency (TF-IDF) vectorization and a Random Forest regressor
   acting as a surrogate model (knowledge emulator) to map high-dimensional
   textual features to ecological compatibility scores. The model achieved
   a coefficient of determination (R2) of 0.980, indicating high fidelity
   in reproducing expert-derived ecological heuristics. To support
   practical applicability, a hybrid ranking function (SHybrid) combines
   learned ecological approximations with user-defined policy priorities,
   such as soil constraints and growth-related preferences. The framework
   culminates in an operational planting plan that supports
   restoration-oriented species allocation across successional groups
   (Pioneer, Secondary, and Climax) aligned with Brazilian restoration
   guidelines (CONAMA Resolution 429/2011). Results indicate that the
   hybrid approach supports restoration-oriented functional organization
   and facilitates the representation of successional niches in restoration
   planning, even when individual species scores vary. While tested in the
   Atlantic Forest biome, the framework remains flexible in ML architecture
   selection and is scalable to other megadiverse biomes. Overall, the
   proposed framework provides forest engineers with a technically
   consistent and operationally informed decision-support strategy for
   restoration planning based on structured silvicultural knowledge.},
