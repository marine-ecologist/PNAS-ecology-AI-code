@article{ WOS:001733216600001,
Author = {Guo, X. J. and Wang, R. X. and Wu, X. L. and Liu, Z. C. and Li, Y. X.
   and Wei, P. Y. and Duan, L. R.},
Title = {SPATIOTEMPORAL DYNAMICS AND CROSS-REGIONAL SPILLOVER OF WATER RESOURCE
   CARRYING CAPACITY IN THE FEN RIVER BASIN, CHINA},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {3767-3788},
Abstract = {Water resources are essential for sustaining socio-economic development
   and ecological health. Under the dual pressures of climate change and
   human activities, intensifying competition for water has exacerbated
   scarcity, pollution, and ecological degradation. Accurate assessment of
   water resource carrying capacity (WRCC) is therefore crucial for
   promoting coordinated human-water development. This study develops a
   Driving force-Pressure-State-Impact-Response-Management (DPSIRM)
   framework and a 35indicator evaluation system to assess WRCC in 41
   counties of the Fen River Basin, China, from 2015 to 2023. WRCC indices
   were calculated using Grey Relational Analysis (GRA) coupled with the
   Technique for Order of Preference by Similarity to Ideal Solution
   (TOPSIS), utilizing the entropy-based CRiteria Importance Through
   Intercriteria Correlation (CRITIC) weighting method. K-means clustering
   and spatial autocorrelation were employed to reveal spatiotemporal
   patterns, while a spatial Durbin model quantified spillover effects and
   key drivers. Results indicate that WRCC experienced a moderate increase,
   with a mean value rising from 0.412 to 0.430, characterized by a
   declining gradient, from the upper reaches to the lower reaches.
   Spatially, WRCC exhibited a ``high-north, low-south{''} pattern with
   core-periphery structures centered on the Taiyuan municipal area and
   Yaodu District. Positive spatial spillovers were observed overall;
   specifically, local WRCC was significantly influenced by water
   endowment, effective irrigation, water conservancy services, and
   economic water intensity. In contrast, water supply, water resource
   development, and hydraulic infrastructure showed heterogeneous
   polarizing or synergistic effects. A fourfold enhancement
   pathway-{''}Quality improvement, Network integration, Consumption
   reduction, and Compensation \& balancing{''}-is proposed to strengthen
   local gains, foster regional coordination, and mitigate negative
   spillovers. These findings provide theoretical and practical guidance
   for water resource planning, cross-regional governance, and the
   sustainable management of coupled water-economic-ecological systems in
   China.},
