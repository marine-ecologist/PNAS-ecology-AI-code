@article{ WOS:001759830700001,
Author = {Zhao, Yu and Ying, Lingxiao and Zhang, Guanshi and Ouyang, Zhiyun},
Title = {Dynamics and driving forces of urban ecosystem assets: Evidence towards
   urban sustainability in Shenzhen, China},
Journal = {ECOLOGICAL FRONTIERS},
Year = {2026},
Volume = {46},
Number = {3},
Pages = {1144-1163},
Month = {JUN},
Abstract = {Urban sustainability is fundamentally conditioned by the status and
   changes of ecosystem assets (EAs), which generate sustained ecosystem
   service benefits and support human well-being and socio-economic growth.
   In rapidly urbanizing regions, intensified ecological pressures reshape
   the integrity and spatial configuration of urban EAs, thereby
   accelerating EAs loss and degradation and eroding urban resilience.
   Clarifying the evolutionary dynamics of EAs and identifying their
   driving forces under urbanization is therefore critical for informing
   adaptive governance and sustainable planning. This study developed an
   improved urban EAs assessment framework involving both extent and
   quality and then combined as an integrated EA index (IEAI), and
   introduced a hybrid ARDL-XGBoost modeling approach alongside coupling
   coordination analysis to examine the interactive relationships between
   EAs and urbanization. The framework was applied to Shenzhen, a rapidly
   urbanizing megacity in China, over the period 1985-2023. Results
   indicate that urban EAs in Shenzhen have undergone marked degradation
   over the past four decades, following a near U-shaped trajectory of
   initial decline and subsequent recovery. IEAI showed a net decline of
   10.52 \%, with declines observed in 84\% of sub-districts, mainly
   concentrated in the western and central parts of the city. EA extent
   contracted dramatically by 32.79 \%, while EA quality first declined and
   then gradually improved. Urban EAs exhibited strong path dependence,
   highlighting the enduring influence of historical trajectories and the
   critical role of long-term policy interventions. Notably, the negative
   impacts of urbanization on EAs have weakened over time, particularly
   after 2005, and the coupling coordination between urbanization and EAs
   showed a significant upward trend, reflecting the effectiveness of
   ecological governance and strategic planning. The findings demonstrate
   that synergistic development between urbanization and EAs is attainable,
   underscoring the importance of embedding EAs management into urban
   sustainable development to ensure durable ecological and social
   benefits.},
