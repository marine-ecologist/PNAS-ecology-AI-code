@article{ WOS:001521817400001,
Author = {Ruiz-Garcia, David and Barria, Claudio and Raga, Juan A. and March,
   David},
Title = {Key drivers of at-vessel mortality in demersal sharks},
Journal = {CONSERVATION BIOLOGY},
Year = {2026},
Volume = {40},
Number = {1},
Month = {FEB},
Abstract = {Chondrichthyans are highly vulnerable to fisheries overexploitation, and
   postcapture mortality poses a significant threat to most species. Global
   bycatch mitigation guidelines recommend adopting hierarchical
   decision-making approaches tailored to species-specific vulnerabilities
   and socioeconomic and regulatory contexts. Effective implementation of
   such strategies requires robust understanding of the factors driving
   vulnerability to postcapture mortality. To address this need, we
   developed a machine learning method to identify key drivers of at-vessel
   mortality (AVM) based on a broad set of biological, environmental, and
   fishing-related parameters. We sought to reveal interactions among
   predictors, nonlinear responses between these variables and mortality
   risk, and threshold values beyond which the likelihood of mortality
   increased markedly. We applied this approach to trawl bycatch data on
   small-spotted catshark (Scyliorhinus canicula) and blackmouth catshark
   (Galeus melastomus) in the western Mediterranean. Body size, air
   temperature, and on-deck time emerged as the primary AVM drivers.
   Mortality risk increased substantially at temperatures above 20 degrees
   C for S. canicula and 16 degrees C for G. melastomus, with on-deck
   exposure exceeding 15 min, and when body size was below 40 and 55 cm,
   respectively. Identification of these drivers and thresholds provides
   valuable insights for bycatch mitigation; can inform strategies for more
   threatened, closely related, or physiologically and ecologically similar
   species; and may support management authorities in adopting targeted
   bycatch avoidance strategies, gear selectivity, and mortality reduction
   measures. Such measures can be tailored to specimens, areas, and periods
   of heightened mortality risk to maximize effectiveness. Furthermore, our
   scalable modeling approach offers a robust tool for identifying critical
   AVM drivers across regions and species, and its applicability can be
   extended to broader fisheries management and global conservation
   efforts.
   Factores principales de la muerte de tiburones demersales a bordo de
   barcos Los condrictios son muy vulnerables a la sobreexplotaci \&
   oacute;n pesquera, y la mortalidad posterior a la captura supone una
   amenaza importante para la mayor \& iacute;a de las especies. Las
   directrices mundiales sobre la mitigaci \& oacute;n de la pesca
   incidental recomiendan adoptar enfoques jer \& aacute;rquicos de toma de
   decisiones adaptados a las vulnerabilidades espec \& iacute;ficas de
   cada especie y a los contextos socioecon \& oacute;micos y normativos.
   La aplicaci \& oacute;n eficaz de tales estrategias requiere una
   comprensi \& oacute;n s \& oacute;lida de los factores que determinan la
   vulnerabilidad a la mortalidad post-captura. Para responder a esta
   necesidad, desarrollamos un m \& eacute;todo de aprendizaje autom \&
   aacute;tico para identificar los factores clave de la mortalidad
   post-captura con base en un amplio conjunto de par \& aacute;metros biol
   \& oacute;gicos, ambientales y relacionados con la pesca. Intentamos
   revelar interacciones entre predictores, respuestas no lineales entre
   estas variables y el riesgo de mortalidad, y valores del umbral a partir
   de los cuales la probabilidad de mortalidad aumentaba notablemente.
   Aplicamos este planteamiento a los datos de capturas accesorias en redes
   de arrastre de Scyliorhinus canicula y Galeus melastomus en el Mediterr
   \& aacute;neo occidental. La talla, la temperatura del aire y el tiempo
   de permanencia en cubierta resultaron ser los principales factores
   determinantes de la mortalidad a bordo. El riesgo de mortalidad aument
   \& oacute; sustancialmente a temperaturas superiores a 20 degrees C para
   S. canicula y 16 degrees C para G. melastomus, con una exposici \&
   oacute;n en cubierta superior a 15 minutos, y cuando la talla era
   inferior a 40 cm y 55 cm, respectivamente. La identificaci \& oacute;n
   de estos factores y umbrales proporciona informaci \& oacute;n valiosa
   para la mitigaci \& oacute;n de la pesca incidental; puede servir de
   base a estrategias para especies m \& aacute;s amenazadas, estrechamente
   relacionadas o fisiol \& oacute;gica y ecol \& oacute;gicamente
   similares; y puede ayudar a las autoridades gestoras a adoptar
   estrategias espec \& iacute;ficas para evitar la pesca incidental,
   selecci \& oacute;n de equipo y medidas de reducci \& oacute;n de la
   mortalidad. Estas medidas pueden adaptarse a los espec \& iacute;menes,
   las zonas y los periodos de mayor riesgo de mortalidad para maximizar su
   eficacia. Adem \& aacute;s, nuestro enfoque de modelo escalable ofrece
   una herramienta robusta para identificar los factores cr \& iacute;ticos
   de mortalidad a bordo en todas las regiones y especies, y su
   aplicabilidad puede extenderse a la gesti \& oacute;n de pesquer \&
   iacute;as m \& aacute;s amplias y a los esfuerzos globales de conservaci
   \& oacute;n. ResumenFactores principales de la muerte de tiburones
   demersales a bordo de barcos Los condrictios son muy vulnerables a la
   sobreexplotaci \& oacute;n pesquera, y la mortalidad posterior a la
   captura supone una amenaza importante para la mayor \& iacute;a de las
   especies. Las directrices mundiales sobre la mitigaci \& oacute;n de la
   pesca incidental recomiendan adoptar enfoques jer \& aacute;rquicos de
   toma de decisiones adaptados a las vulnerabilidades espec \&
   iacute;ficas de cada especie y a los contextos socioecon \& oacute;micos
   y normativos. La aplicaci \& oacute;n eficaz de tales estrategias
   requiere una comprensi \& oacute;n s \& oacute;lida de los factores que
   determinan la vulnerabilidad a la mortalidad post-captura.
   Para responder a esta necesidad, desarrollamos un m \& eacute;todo de
   aprendizaje autom \& aacute;tico para identificar los factores clave de
   la mortalidad post-captura con base en un amplio conjunto de par \&
   aacute;metros biol \& oacute;gicos, ambientales y relacionados con la
   pesca. Intentamos revelar interacciones entre predictores, respuestas no
   lineales entre estas variables y el riesgo de mortalidad, y valores del
   umbral a partir de los cuales la probabilidad de mortalidad aumentaba
   notablemente. Aplicamos este planteamiento a los datos de capturas
   accesorias en redes de arrastre de Scyliorhinus canicula y Galeus
   melastomus en el Mediterr \& aacute;neo occidental. La talla, la
   temperatura del aire y el tiempo de permanencia en cubierta resultaron
   ser los principales factores determinantes de la mortalidad a bordo. El
   riesgo de mortalidad aument \& oacute; sustancialmente a temperaturas
   superiores a 20 degrees C para S. canicula y 16 degrees C para G.
   melastomus, con una exposici \& oacute;n en cubierta superior a 15
   minutos, y cuando la talla era inferior a 40 cm y 55 cm,
   respectivamente. La identificaci \& oacute;n de estos factores y
   umbrales proporciona informaci \& oacute;n valiosa para la mitigaci \&
   oacute;n de la pesca incidental; puede servir de base a estrategias para
   especies m \& aacute;s amenazadas, estrechamente relacionadas o fisiol
   \& oacute;gica y ecol \& oacute;gicamente similares; y puede ayudar a
   las autoridades gestoras a adoptar estrategias espec \& iacute;ficas
   para evitar la pesca incidental, selecci \& oacute;n de equipo y medidas
   de reducci \& oacute;n de la mortalidad. Estas medidas pueden adaptarse
   a los espec \& iacute;menes, las zonas y los periodos de mayor riesgo de
   mortalidad para maximizar su eficacia. Adem \& aacute;s, nuestro enfoque
   de modelo escalable ofrece una herramienta robusta para identificar los
   factores cr \& iacute;ticos de mortalidad a bordo en todas las regiones
   y especies, y su aplicabilidad puede extenderse a la gesti \& oacute;n
   de pesquer \& iacute;as m \& aacute;s amplias y a los esfuerzos globales
   de conservaci \& oacute;n. Resumen},
