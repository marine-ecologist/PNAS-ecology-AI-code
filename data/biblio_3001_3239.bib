@article{ WOS:001845186400001,
Author = {Dutta, Kishore},
Title = {The variational dynamics of sustainability: A constraint-landscape
   framework within DAKM},
Journal = {ECOLOGICAL MODELLING},
Year = {2026},
Volume = {521},
Month = {NOV},
Abstract = {Coupled socio-ecological systems exhibit nonlinear adjustment, path
   dependence, and regime-dependent dynamics arising from interactions
   between material throughput and ecological constraints. This work
   develops a variational modelling framework in which system evolution is
   governed by a stationarity condition applied to a Lagrangian combining
   material accumulation (qA), experiential activity (qK), and a constraint
   landscape VD representing ecological and institutional limits.
   Constraint gradients enter the equations of motion directly, a
   continuity relation links local accumulation to system-wide resource
   flows, and dissipation generates directional adjustment toward
   dynamically stable configurations. Sustainability is defined as a
   property of admissible trajectories characterised by bounded evolution,
   monotonic energy decay, and consistency between accumulation and
   redistribution. Non-convex constraint landscapes generate multiple
   stable regimes and path-dependent trajectories, permitting analysis of
   resilience, regime persistence, and socio-ecological transitions under
   non-equilibrium conditions. An empirical illustration using World Bank
   panel data from five economies over 2000-2021 examines whether observed
   trajectories are consistent with the framework's dynamical predictions.
   Directional adjustment is statistically confirmed across the panel,
   coupling between qA and qK composites varies systematically with
   development regime, and cross-correlation analysis reveals qualitatively
   distinct lag structures across economies consistent with convex and
   non-convex constraint geometries. Panel Granger causality results are
   consistent with an asymmetric structure in which the constraint
   landscape shapes accumulation dynamics rather than being passively
   determined by it, although Granger precedence reflects statistical
   rather than structural causation. Permutation-based feature importance
   from an explainable machine learning decomposition is consistent with
   the theoretical ordering of state-variable contributions to VD.
   Phase-space portraits reveal qualitatively distinct trajectory
   geometries across economies, consistent with the prediction that
   heterogeneous ecological and institutional constraint structures
   generate distinct dynamical regimes. The empirical results are
   illustrative of consistency with the framework's dynamical predictions
   rather than a direct estimation of its structural equations.},
