@article{ WOS:001733212000001,
Author = {Dai, X. L. and Chen, D. J.},
Title = {RESEARCH ON PREDICTING THE IMPACT OF URBAN EXPANSION ON LOW-CARBON
   ECOLOGICAL ZONES USING DEEP LEARNING MODELS},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {3},
Pages = {3891-3911},
Abstract = {To address the problem of accurately predicting urban expansion dynamics
   and assessing their impacts on low-carbon ecological zones, we propose
   FlowUrban, a novel deep learning framework that integrates urban
   expansion prediction with carbon sink impact assessment. By leveraging
   generative modeling based on flow matching, FlowUrban incorporates a
   Selective State-Space Temporal Encoder (S3-TE) to capture long-range
   temporal dependencies, a Hierarchical Gated Cross-Scale Aggregation
   (HG-CSA) module to address multi-scale spatial heterogeneity, a
   Physically Constrained Flow Matching (PC-FM) module to ensure spatial
   coherence while enforcing ecological constraints, and a Carbon Sink
   Coupling Head (CS-Head) to integrate urban expansion prediction with
   carbon sink assessment through multi-task learning. Experimental results
   demonstrate that FlowUrban outperforms the best baseline method by
   3.25\% and 3.44\%, achieving Figures of Merit (FoM) of 48.92\% and
   47.56\%, respectively, on two representative urban agglomerations. For
   carbon sink prediction, FlowUrban reduces RMSE by 17.88\% and 18.70\%
   compared to conventional post-processing approaches, with R2 values
   reaching 0.912 and 0.902. These results provide valuable guidance for
   low-carbon urban planning and point to a new direction for the
   integration of land-use simulation with ecological impact assessment.},
