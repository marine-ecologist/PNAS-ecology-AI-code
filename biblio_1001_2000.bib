@inproceedings{ WOS:000084441600023,
Author = {Gupta, A},
Editor = {Farina, A},
Title = {Matrix models in ecology},
Booktitle = {PERSPECTIVES IN ECOLOGY: A GLANCE FROM THE VII INTERNATIONAL CONGRESS OF
   ECOLOGY},
Year = {1999},
Pages = {197-203},
Note = {7th International Congress of Ecology, FLORENCE, ITALY, JUL 19-25, 1998},
Abstract = {The symposium ``Matrix Models in Ecology{''} was one of the themes for
   the proposed symposium on the occasion of the VII International Congress
   of Ecology at Florence, Italy on 21st July 98. A total of 7 papers were
   presented whereas one was included in the poster session. The
   presentations in the symposium made use of matrix models for analysing
   spatio-temporal variations in the demography of the perennial plant,
   Ascophyllum nodosum (Aberg, 1998) for forest management and restoration
   using transient dynamics and patterns of environmental dependence of
   matrix entries (Boucher, 1998), in predicting asymptotic dynamics
   (Cushing, 1998), in weed management (Gupta, 1998), in artificial neural
   networks (Scardi, 1998), matrix models in habitat suitability
   (Schroeder, 1998), invasion process and density dependent matrix models
   (Takada, 1998), matrix models in describing behaviour of diverse
   micro-organisms in activated sludge (Spagni et al., 1998). The speakers
   were Aberg, P. (Sweden), Boucher, D. (Maryland, USA), Gushing, J.M.
   (USA), Gupta, A. (India), Scardi, M. (Italy), Schroeder, B. (Germany)
   and Takada, T. (Japan). The papers have laid the foundation for the
   understanding of the dynamic nature and relative roles of models in
   ecology. The symposium has served to highlight issues like phenomenology
   and mechanism of invasion, whether single large or several small
   reserves afford extinction risk, understanding of environmental
   disturbance causing changes in properties of negative feedback structure
   precipitating the dynamic population behaviour, etc. In the opening
   remarks the chairperson emphasised on the roles of matrix models for
   application in ecology. It was also brought to the notice that the
   potential of Marcovian models have not been totally explored in ecology
   and the matrix models can be useful for investigating various scientific
   and management questions concerning species preservation. The approach
   is timely as many natural populations have come under harvest pressure
   from human beings and others have suffered toxicity impact affecting
   their fecundity. The discussion has led to the ways, the future work may
   be considered.},
