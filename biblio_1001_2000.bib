Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Ceulemans, R (Corresponding Author), Univ Potsdam, Inst Biochem \& Biol, Neuen Palais 10, D-14469 Potsdam, Germany.
