@article{ WOS:001631698000001,
Author = {Bendaas, Yehya and Grimes, Samir and Benzouai, Siham},
Title = {Posidonia oceanica mapping in the southwestern Mediterranean Sea using
   remote sensing and field data: Application of Sentinel-2 on the Algerian
   coast},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
Year = {2026},
Volume = {93},
Month = {JAN},
Abstract = {Posidonia oceanica is an endemic seagrass of the Mediterranean Sea,
   providing numerous ecosystem services and ecological functions. Mapping
   this seagrass can provide a valuable tool for its conservation,
   estimating its socioeconomic values, and assessing human impact. Two
   localities along the Algerian coast in the southwestern Mediterranean
   Sea were selected for mapping the main P. oceanica meadows distribution
   using remote sensing data and field surveys. A pixel-based supervised
   classification approach was applied to atmospherically corrected, sun
   glint corrected, and water column corrected bands of Sentinel-2 imagery
   using three supervised algorithms: Maximum Likelihood Classifier, Random
   Forest, and Support Vector Machine. First, we evaluated the accuracy of
   these experiments by combining input bands and classifiers. Then, the
   most accurate technique was used for mapping the overall distribution of
   P. oceanica over the entire studied area. This study demonstrated the
   capability of Sentinel-2 for mapping P. oceanica meadows with high
   accuracy with all classifiers ranging from (OA=85.63, k = 76.44) to
   (OA=89.66, k = 82.73) when using atmospherically corrected bands and
   deglinted bands; however, the lowest overall accuracies were obtained
   with water column correction from (OA=67.24, k = 46.35) to (OA=74.14, k
   = 57.27). The application of remote sensing with field data allowed us
   to map an area of 19.60 km2 in Tipaza along 80 of the coastlines with an
   accuracy of (OA=83.3, k = 72.77) and an area of 8.98 km2 along 50 km in
   Jijel with an accuracy of (OA=79.49, k = 65.08). The obtained results
   serve as a baseline for P. oceanica distribution and will be integrated
   into the national database on marine biodiversity (BANBIOM). The
   availability of such informative maps is a valuable tool for helping
   decision-makers with seagrass conservation, the development of effective
   management strategies in the coastal area, and maritime spatial
   planning.},
