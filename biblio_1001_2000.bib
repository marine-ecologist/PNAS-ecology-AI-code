@article{ WOS:001766618200001,
Author = {Chen, Jing-zhong and Xie, Yuan-gui and Xiao, Sheng-yang and Zhang,
   Lan-yue and Qian, Wang and Liao, Xiao-feng},
Title = {Long-term geological and contemporary environmental interactions
   contribute to biodiversity and ecological function in Fanjing Mountain,
   China},
Journal = {GLOBAL ECOLOGY AND CONSERVATION},
Year = {2026},
Volume = {68},
Month = {AUG},
Abstract = {Mountains are important reservoirs of terrestrial biodiversity on Earth.
   Their biodiversity and ecosystem functions are shaped by both climatic
   factors and long-term geological processes, yet the mechanisms
   underlying their mutual regulation remain unclear. Fanjing Mountain is
   one of China's 14 key areas for Terrestrial Biodiversity of Global
   Significance, and its complex ecogeological environment has fostered
   exceptionally high biodiversity. Based on data regarding rock mineralogy
   and elemental composition, soil properties, climate, plant and soil
   microbial diversity, and ecosystem functions in Fanjing Mountain, this
   study integrates Multi-Model Inference (MMI), Random Forest (RF), and
   Structural Equation Modeling (SEM) to elucidate the mechanisms by which
   the eco-geological environment shapes biodiversity and ecosystem
   functions at the micro-regional scale. The results indicate that the
   explanatory power of the model significantly improves when long-term
   geological variables are incorporated, and that long-term geological and
   contemporary environmental processes jointly regulate the BEF pattern.
   Climate dominates biodiversity changes, while lithology and temperature
   serve as core drivers of ecosystem functions; long-term geological
   processes, acting as upstream factors, are negatively correlated with
   biological processes, thereby exerting a buffering regulatory effect.
   The study area exhibits no distinct altitudinal differentiation and
   generally follows a fuzzy threshold-break pattern, with driving effects
   exhibiting scale dependence. This multi-model system can effectively
   elucidate the driving mechanisms of small-sample data in mountainous
   regions and provides a scientific basis for biodiversity conservation in
   the mountainous areas of South China.},
