@article{ WOS:001813963500001,
Author = {Olubaju, Ayomide and Akinbiola, Sehinde},
Title = {Beyond the dark patch: Reimagining ai-driven oil spill detection for a
   global environmental crisis},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
Year = {2026},
Volume = {100},
Month = {JUL},
Abstract = {Oil spills represent one of the most persistent and environmentally
   devastating forms of pollution affecting marine, coastal, and onshore
   ecosystems worldwide. The past decade has witnessed a significant shift
   from traditional detection methods toward artificial intelligence
   (AI)-driven approaches, particularly deep learning models applied to
   Synthetic Aperture Radar (SAR) and optical satellite imagery. While
   these advances have substantially improved detection accuracy in
   controlled settings, critical gaps remain in model generalisability,
   geographic transferability, explainability, and operational deployment,
   particularly in data-scarce, ecologically complex, and politically
   sensitive environments. This perspective critically examines the current
   state of AI for oil spill detection, identifies persistent
   methodological blind spots, and advocates for a new generation of
   transparent, context-sensitive, and geographically inclusive detection
   frameworks that go beyond performance metrics toward real-world
   environmental impact},
