@article{ WOS:001776714700001,
Author = {Owens, Alasdair F. and Estrada, Erik and Hockings, Kimberley J. and
   Imron, Muhammed Ali and Mariaty and Sharma, Manmohan D. and Maimunah,
   Siti and Travers-Cook, Tommy J. and Van Veen, Frank J. F. and Erb, Wendy
   M.},
Title = {Passive Acoustic Monitoring and Deep Learning Reveal a Lag From Rainfall
   to Gibbon Song Across a Mosaic Forest Landscape},
Journal = {ECOLOGY AND EVOLUTION},
Year = {2026},
Volume = {16},
Number = {6},
Month = {MAY 27},
Abstract = {Understanding the fundamental ecology of endangered species is essential
   for effective conservation, yet this remains challenging for elusive
   species inhabiting tropical forests. For the endangered Bornean
   white-bearded gibbon (Hylobates albibarbis), much of the available
   ecological information derives from peat swamp forests, while
   comparatively little is known from other forest types that make up a
   large part of its range. Passive acoustic monitoring provides an
   opportunity to address this gap, enabling the study of species' vocal
   behaviour over larger spatial and temporal scales than previously
   possible. We deployed eight autonomous recording units across three
   forest types in Central Kalimantan, Indonesia, collecting 23,244 h of
   acoustic data over 18 months. A pretrained deep learning detector was
   applied to identify great calls, performed by female gibbons as part of
   morning duets and used as a key indicator for comparing population
   density. We identified 83,956 great calls and examined how daily calling
   activity varied across habitats and in response to seasonal rainfall.
   Daily calling activity differed significantly among forest types,
   consistent with expected differences in gibbon population density.
   Significant temporal variation in calling behaviour was observed
   consistently across habitats. We documented negative short-term and
   positive long-term effects of rainfall on calling activity. Daily
   calling activity peaked 51-52 days following rainfall events, with
   effect sizes increasing with rainfall dose, suggesting that calling
   activity reflects a lagged phenological fruiting response to seasonal
   rainfall. Our findings highlight the importance of accounting for
   variable vocalisation rates in acoustic monitoring, particularly when
   evaluating the additive effects of anthropogenic disturbance and climate
   change on species' behaviour and ecology. We emphasise the value of
   incorporating spatial data to strengthen ecological inferences from
   acoustic datasets, and demonstrate the power of deep learning for
   long-term monitoring of species' vocal behaviour, providing deeper
   ecological understanding across increasingly broad spatiotemporal
   scales.
   Memahami ekologi dasar spesies terancam punah merupakan kunci bagi upaya
   konservasi yang efektif. Namun, hal ini menjadi tantangan besar,
   terutama bagi spesies yang sulit diamati di hutan tropis. Pada owa
   jenggot putih Kalimantan (Hylobates albibarbis), sebagian besar
   informasi ekologi yang tersedia masih terbatas pada hutan rawa gambut,
   sementara pengetahuan dari tipe hutan lain, yang justru mencakup
   sebagian besar wilayah jelajahnya, masih minim. Penggunaan teknologi
   passive acoustic monitoring menawarkan peluang untuk mengatasi
   kesenjangan ini, dengan memungkinkan studi perilaku vokal spesies pada
   skala ruang dan waktu yang lebih luas dibandingkan metode konvensional.
   Kami menempatkan delapan unit perekam suara otonom di tiga tipe hutan di
   Kalimantan Tengah, Indonesia, dan mengumpulkan total 23.244 jam data
   akustik selama 18 bulan. Detektor deep learning pralatih digunakan untuk
   mengidentifikasi great calls, yaitu vokalisasi khas yang dilakukan oleh
   owa betina sebagai bagian dari duet pagi. Vokalisasi ini digunakan
   sebagai indikator utama dalam estimasi kepadatan populasi. Secara
   keseluruhan, kami mengidentifikasi 83.956 great calls dan menganalisis
   variasi aktivitas panggilan harian antar habitat serta responsnya
   terhadap curah hujan musiman. Aktivitas panggilan harian menunjukkan
   perbedaan yang signifikan antar tipe hutan, sejalan dengan variasi
   perkiraan kepadatan populasi owa. Selain itu, terdapat variasi temporal
   yang jelas dalam perilaku panggilan, meskipun pola ini relatif konsisten
   di seluruh habitat. Kami menemukan adanya efek negatif jangka pendek
   serta efek positif jangka panjang dari curah hujan terhadap aktivitas
   panggilan. Aktivitas panggilan mencapai puncaknya 51-52 hari setelah
   periode curah hujan, dengan besaran efek yang meningkat seiring
   intensitas hujan. Pola ini konsisten dengan aktivitas panggilan yang
   mengikuti respons fenologi pembuahan yang tertunda terhadap curah hujan
   musiman. Temuan ini menegaskan pentingnya mempertimbangkan variasi laju
   vokalisasi dalam pemantauan akustik, khususnya dalam mengevaluasi dampak
   kumulatif gangguan antropogenik dan perubahan iklim terhadap perilaku
   serta ekologi spesies. Kami juga menekankan pentingnya integrasi data
   spasial untuk memperkuat inferensi ekologi dari dataset akustik. Lebih
   lanjut lagi, hasil penelitian menunjukkan potensi besar pendekatan deep
   learning dalam pemantauan jangka panjang dan berskala luas terhadap
   perilaku vokal, sehingga dapat memperluas pemahaman ekologi spesies pada
   dimensi ruang dan waktu yang lebih komprehensif.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
