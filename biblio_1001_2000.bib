@article{ WOS:001844358500001,
Author = {Verma, Amit Kumar and Ojha, Sai Pratik and Kumar, Sandeep},
Title = {Ensemble modelling of habitat suitability and potential range shifts
   of Betula utilis in the Western Himalaya under climate
   change scenarios},
Journal = {FLORA},
Year = {2026},
Volume = {343},
Month = {OCT},
Abstract = {Betula utilisis an ecologically and culturally important tree species of
   the Western Himalayas. Owing to its sensitivity to temperature and
   moisture, understanding its response to ongoing and future climate
   change is essential for conservation planning. In this study, an
   ensemble Species Distribution Modelling (SDM) approach was applied using
   all bioclimatic variables (Bio1 to Bio19) to assess current distribution
   patterns and project future shifts in the suitable habitat ofB.
   utilisover the Western Himalaya. Multiple modelling approaches,
   including Random Forest (RF), Maximum Entropy (MaxEnt), Support Vector
   Machine (SVM), Boosted Regression Trees (BRT), Multi-Layer Perceptron
   (MLP), and Multivariate Adaptive Regression Splines (MARS), were
   integrated under four CMIP6 Shared Socioeconomic Pathways (SSP1-2.6,
   SSP2-4.5, SSP3-7.0, and SSP5-8.5) for the periods 2021-2040, 2041-2060,
   2061-2080, and 2081-2100. The ensemble model showed high predictive
   performance (AUC 0.92-0.96; TSS up to 0.86), with Annual Mean
   Temperature (Bio1), Mean Diurnal Range (Bio2), Maximum Temperature of
   the Warmest Month (Bio5), Precipitation of the Driest Month (Bio14), and
   Precipitation of the Coldest Quarter (Bio19) emerging as the most
   influential predictors for habitat distribution ofB. utilis. Projections
   indicate a consistent upslope shift in suitable habitat along with
   substantial habitat shrinkage. Under the SSP5-8.5 scenario, about
   47.57\% (12,868 km(2)) of current suitable habitat may be lost by
   2081-2100, while newly suitable areas remain minimal (<1.5\%), resulting
   in limited and fragmented colonization. Persistent habitats are largely
   restricted to higher elevations, indicating greater ecological
   vulnerability. The findings underscore the need for targeted
   conservation interventions, such as habitat restoration and assisted
   habitat shift ofB. utilis. In addition, the ensemble modelling framework
   is useful for evaluating climate-induced changes in distribution in the
   Western Himalaya.},
