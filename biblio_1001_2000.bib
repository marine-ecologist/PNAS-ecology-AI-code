@article{ WOS:001710980700001,
Author = {Gao, Ruiyang and Zhang, Fan and Zhang, Shouhong and Ren, Yufei and Li,
   Ruixian and Chen, Jingqiu and Li, Shuohan and Fan, Juntao},
Title = {Assessing ecological performance of urban community green
   infrastructure: A hybrid IVIF-TOPSIS-EW and interpretable machine
   learning framework},
Journal = {ECOLOGICAL FRONTIERS},
Year = {2026},
Volume = {46},
Number = {2},
Pages = {670-682},
Month = {APR},
Abstract = {Community green infrastructure (CGI) plays a crucial role in mitigating
   environmental stressors, regulating urban heat island, and enhancing
   human well-being in rapidly urbanizing areas. However, its ecological
   performance remains difficult to assess due to limited tools. This study
   proposes a hybrid assessment framework integrating the interval-valued
   intuitionistic fuzzy-based TOPSIS and entropy weighting (IVIF-TOPSIS-EW)
   and interpretable machine learning (IML) for measuring CGI ecological
   performance. Systematic environmental and social investigations were
   conducted in 36 representative communities from six cities in northern
   China. The proposed framework was applied to quantify ecological
   performance and identify the driving mechanisms of key factors. Results
   indicate that: (1) The IVIF-TOPSIS-EW method effectively identified
   significant differences in CGI ecological performance across cities,
   with communities in Beijing scoring significantly higher than those in
   other cities (p < 0.05). Communities with newer construction, lower
   building density, higher economic, and management levels exhibited
   better ecological performance. (2) IML analysis identified community
   area, building density, and housing price index as key drivers of CGI
   ecological performance. Large communities (>5.54 ha) and low building
   densities (<30.26 \%) generally exhibited better ecological performance.
   (3) To enhance CGI performance, improving the efficiency of land use is
   essential in communities with high building density (>30.26 \%) or
   limited land area (<5.54 ha). In economically constrained communities,
   low-cost, participatory greening initiatives were essential for
   fostering community engagement and supporting long-term ecological
   sustainability. The novel hybrid assessment framework proposed in this
   study effectively quantifies the ecological performance of CGI and
   reveals its primary driving factors. The findings offer practical
   insights for enhancing CGI outcomes and promoting sustainable urban
   development.},
