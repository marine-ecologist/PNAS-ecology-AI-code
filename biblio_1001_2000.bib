@article{ WOS:001838750800001,
Author = {Vo, Xoan Bich and Le, Truc Van and Nguyen, Tung Gia and La, An Thuy and
   Doan, De Ngoc and Tran, Thai Thanh},
Title = {Environmental correlates of parasitic isopod Portunion
   conformis abundance in mud crabs (Scylla spp.) from tropical
   coastal aquaculture ponds},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
Year = {2026},
Volume = {101},
Month = {AUG},
Abstract = {Parasitic isopods are an emerging concern in mud crab aquaculture in
   tropical coastal ponds, yet the pond conditions associated with
   infection remain poorly characterised. This study examined the
   environmental correlates of Portunion conformis abundance in mud crabs
   (Scylla spp.). Thirteen aquaculture ponds in the Ca Mau Peninsula,
   Vietnam, were sampled twice monthly during 2025. Parasite abundance was
   averaged across the 3-5 crabs collected from each pond at each sampling
   time, yielding 308 pond-level records paired with seven water quality
   variables: pH, temperature, salinity, dissolved oxygen, transparency,
   chemical oxygen demand, and H2S. P. conformis was detected in 85.39\% of
   these records (263 of 308). Three machine learning models, XGBoost,
   Random Forest, and Support Vector Machine, were used to examine the
   associations between pond-level abundance and these variables, and were
   benchmarked against a generalized linear model and a generalized
   additive model; a generalized additive mixed model was fitted as a
   sensitivity analysis to account for pond-level random effects. Because
   ponds were sampled repeatedly, model performance was assessed by
   pond-blocked cross-validation with entire ponds held out. XGBoost
   performed best (leave-one-pond-out R2 = 0.515), with model ranking
   unchanged across validation schemes. SHAP analysis identified
   temperature and H2S as the most important correlates of abundance, while
   pH, chemical oxygen demand, salinity, and transparency showed weaker,
   nonlinear associations. These results indicate that P. conformis
   abundance is associated with multiple pond conditions, including thermal
   stress, reduced benthic conditions, organic enrichment, and salinity,
   and provide ecological evidence to support parasite surveillance and
   water quality monitoring in tropical mud crab aquaculture.},
Publisher = {ELSEVIER},
Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Tran, TT (Corresponding Author), Vietnam Acad Sci \& Technol, Inst Life Sci, 85 Tran Quoc Toan St, Ho Chi Minh City 700000, Vietnam.
