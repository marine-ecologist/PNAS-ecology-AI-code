@article{ WOS:001831161200001,
Author = {Liu, Yang and Xiao, Hong and Rong, Yuping and Xu, Changlin and Han, Ao
   and Ma, Kai and Wang, Yun},
Title = {Shrub encroachment drives multifunctionality trade-offs by reorganizing
   plant and microbial communities in an alpine meadow},
Journal = {AGRICULTURE ECOSYSTEMS \& ENVIRONMENT},
Year = {2026},
Volume = {411},
Month = {NOV 1},
Abstract = {Shrub encroachment is altering grassland ecosystems worldwide, however,
   the mechanisms underlying its impacts on ecosystem multifunctionality
   (EMF), particularly the regulatory roles of herbaceous plants and soil
   microbial communities, remain insufficiently understood. In this study,
   we explored the effects of Salix oritrepha encroachment at three levels
   (light, moderate, and heavy) on 17 ecosystem functions in an alpine
   meadow on the Tibetan Plateau. By integrating multivariate statistics
   and structural equation modeling (SEM), we evaluated how plant
   communities, soil properties, and microbial communities collectively
   influence EMF. Our results revealed that shrub encroachment caused
   significant trade-offs among ecosystem functions. Although aboveground
   plant productivity increased, primarily due to a shift toward forb
   dominance, this increase was accompanied by a decline in herbaceous
   species diversity. Notably, belowground multifunctionality, assessed
   through soil carbon, nitrogen, and phosphorus cycling, declined linearly
   across the three shrub encroachment levels (P < 0.05). Random forest
   analysis identified the composition of bacterial and herbaceous plant
   communities as the primary predictors of multifunctionality, while SEM
   further demonstrated that herbaceous and fungal community composition
   directly regulates EMF. Our study highlights the importance of
   considering both the extent of shrub encroachment and the specificity of
   ecosystem functions in assessing the ecological impacts of woody
   expansion. These findings provide a mechanistic understanding of how
   shrub encroachment drives tradeoffs in EMF by reorganizing plant and
   microbial communities. They also highlight the need for integrated
   management strategies that control shrub coverage while preserving
   biodiversity to sustain multifunctionality in alpine grassland
   ecosystems.},
