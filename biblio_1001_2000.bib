@article{ WOS:001756701600001,
Author = {Wang, Xinshihui and He, Zitong and Jiang, Yueyi and Wang, Jichao and
   Liu, Bo and Long, Haixia},
Title = {SOCI-YOLO11n: A deep learning model for identifying invasive freshwater
   turtles in complex ecological contexts},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {95},
Month = {MAY},
Abstract = {The spread of freshwater turtles, especially the invasive Red-Eared
   Slider (Trachemys scripta elegans), poses serious risks to ecosystem
   integrity and biodiversity in Hainan, China-including competitive
   displacement of native species, pathogen transmission, and disruption of
   local aquatic food webs. Traditional monitoring methods are often
   inefficient, costly, and lack real-time responsiveness. To address these
   challenges, we propose SOCI-YOLO11n, an enhanced detection model based
   on YOLO11n, designed to improve detection performance under complex
   backgrounds, low contrast, and multi-scale conditions. The model
   integrates an Online Re-parameterization (OREPA) module for faster
   training, a Scale-Adaptive Convolution (SAConv) module for improved
   scale sensitivity, and a Convolutional Block Attention Module (CBAM) to
   reduce background noise. An InnerIoU loss function is further employed
   to enhance localization accuracy. On an augmented dataset of seven
   turtle species, SOCI-YOLO11n achieves a mAP50 of 0.937 with only 4.7
   GFLOPs, attaining a precision of 0.942 and recall of 0.877. Ablation and
   visualization experiments confirm its robustness and accuracy under
   ecological challenges. Moreover, deployment tests on edge devices (e.g.,
   Jetson Nano) demonstrate its potential for integration into ecological
   monitoring systems, offering scalable, efficient, and low-false-alarm
   surveillance for invasive species management.},
