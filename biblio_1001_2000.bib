@article{ WOS:001052222500002,
Author = {Rosenboom, Ilona and Pust, Marie-Madlen and Pirr, Sabine and Bakker,
   Alina and Willers, Maike and Davenport, Colin F. F. and Wiehlmann, Lutz
   and Viemann, Dorothee and Tuemmler, Burkhard},
Title = {Longitudinal development of the airway metagenome of preterm very low
   birth weight infants during the first two years of life},
Journal = {ISME COMMUNICATIONS},
Year = {2023},
Volume = {3},
Number = {1},
Month = {JUL 20},
Abstract = {Preterm birth is accompanied with many complications and requires severe
   therapeutic regimens at the neonatal intensive care unit. The influence
   of the above-mentioned factors on the premature-born infants'
   respiratory metagenome or more generally its maturation is unknown. We
   therefore applied shotgun metagenome sequencing of oropharyngeal swabs
   to analyze the airway metagenome development of 24 preterm infants from
   one week postpartum to 15 months of age. Beta diversity analysis
   revealed a distinct clustering of airway microbial communities from
   hospitalized preterms and samples after hospital discharge. At nine and
   15 months of age, the preterm infants lost their hospital-acquired
   individual metagenome signatures towards a common taxonomic structure.
   However, ecological network analysis and Random Forest classification of
   cross-sectional data revealed that by this age the preterm infants did
   not succeed in establishing the uniform and stable bacterial community
   structures that are characteristic for healthy full-term infants.},
