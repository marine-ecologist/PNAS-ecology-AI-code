@article{ WOS:001798577000001,
Author = {Ai, Shenghao and Liu, Jia and Sheng, Meihua and Ai, Xiaoyan},
Title = {Effects of ecological restoration measures on phosphorus fractions in
   cut slope soils of the Western Sichuan Plateau},
Journal = {ECOLOGICAL ENGINEERING},
Year = {2026},
Volume = {231},
Month = {OCT},
Abstract = {Given the fragility of cut-slope habitats in the plateau regions of
   Western Sichuan, numerous ecological restoration measures have been
   implemented to enhance soil and phosphorus (P) availability, aiming to
   restore vegetation cover and improve soil health in these ecosystems.
   However, the differences in P pools of cut slopes soil under different
   restoration measures remain unclear. To address this, the present study
   aims to assess soil total P (TP), available P (AP), and P fractions
   under selected restoration measures. These specific measures were
   selected because they represent the typical restoration measures widely
   utilized in Western Sichuan. Specifically, the investigated sites
   include two slopes restored using the external soil spray seeding (ESSS)
   technique combined with distinct physical stabilization structures-one
   utilizing galvanized iron wire mesh (GS) and the other utilizing frame
   beams (FS)-alongside a naturally restored cut slope (RS) and an
   undisturbed naturally developed slope (NS) serving as the control.
   According to the obtained results, the TP contents across all slopes
   ranged from 442.48 to 630.69 mg kg- 1. The highest AP content was
   observed in the NS (9.17 mg kg- 1), which was significantly higher than
   those in the other three cut slopes (ranging from 3.99 to 4.91 mg kg-
   1). Furthermore, GS and FS did not result in statistically significant
   differences in soil TP and AP compared to the RS. Despite this lack of
   difference in overall P levels, these specific restoration measures
   distinctly altered the compositional distribution of soil P pools.
   Principal component analyses demonstrated a distinct separation between
   the restored slopes (GS and FS) and the RS in terms of inorganic P
   fractions. In contrast, their separation based on organic P fractions
   was relatively minor, indicating that the restoration measures
   predominantly reshaped the inorganic P pool. Moreover, the Random Forest
   algorithm showed that the total organic P, organic matter, sodium
   hydroxide-extracted Po, and available nitrogen were the primary factors
   affecting the soil AP contents. These results suggest that managing soil
   organic matter and mitigating nitrogen limitation to facilitate organic
   P mineralization represent practical approaches for improving soil P
   availability and restoring slope habitats in the Western Sichuan
   Plateau.},
