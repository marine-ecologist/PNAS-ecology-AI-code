DOI = {10.1016/j.ecolecon.2014.04.018},
ISSN = {0921-8009},
EISSN = {1873-6106},
Keywords = {Adaptive management; Learning by doing; Renewable resources; Thresholds;
   Neural networks; Reinforcement learning; Agent based modeling},
Keywords-Plus = {SOCIAL-ECOLOGICAL SYSTEMS; COMPLEX ADAPTIVE SYSTEMS; RESILIENCE;
