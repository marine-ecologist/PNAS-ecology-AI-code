@article{ WOS:001560523600023,
Author = {Tian, Ziang and Liu, Shiliang and Wang, Wanting and Li, Yetong and Lin,
   Jiayi and Zhao, Yifei and Wu, Gang},
Title = {Response of regional ecological network change and its interaction with
   ecosystem services associated with ``Shan-Shui initiative{''} projects},
Journal = {ECOLOGICAL FRONTIERS},
Year = {2025},
Volume = {45},
Number = {5},
Pages = {1429-1443},
Month = {OCT},
Abstract = {China's ``Shan-Shui Initiative{''}, officially known as the ``Integrated
   Protection and Restoration Project of Mountains, Forests, Fields, Lakes,
   Grasslandes and Sands{''}, represents a systematic efforts to enhance
   ecological integrity, diversity, and sustainability across the nation.
   However, its regional impacts on ecological network (EN) connectivity,
   stability, and ecosystem services (ES) remain underexplored. This study
   addresses this gap by integrating Graphab, InVEST model, and machine
   learning techniques to evaluate the ecological outcomes of restoration
   projects in the Dongting Lake Basin. We assessed changes in EN
   connectivity and robustness, identified key stepping-stone patches, and
   performed global efficiency analyses under simulated random and targeted
   disturbances. The coupling mechanisms between EN structure and ES
   functions were further explored through predictive modeling of habitat
   quality and carbon storage. Results demonstrated that the ``Shan-Shui
   Initiative{''} significantly enhanced ecological connectivity, with the
   Integral Connectivity Index (IIC) increasing by 47.93 \% and the
   Probability of Connectivity (PC) increasing by 28.88\%. Ecological
   corridors expanded from 72 to 115, improving landscape cohesion and
   mitigating patch isolation. Moreover, network robustness was markedly
   strengthened under both disturbance scenarios. The machine learning
   predictions of habitat quality and carbon storage further highlighted
   the applicability of patch importance indices in ES modeling. By
   integrating EN optimization with ES prediction, it provides a innovative
   framework for advancing ecological conservation and sustainable
   landscape management.},
