@article{ WOS:000489493300001,
Author = {Molina-Vacas, Guillem and Munoz-Mas, Rafael and Martinez-Capel,
   Francisco and Domingo Rodriguez-Teijeiro, Jose and Le Fohlic, Guillaume},
Title = {Movement patterns of forest elephants (Loxodonta cyclotis
   Matschie, 1900) in the Odzala-Kokoua National Park, Republic of Congo},
Journal = {AFRICAN JOURNAL OF ECOLOGY},
Year = {2020},
Volume = {58},
Number = {1},
Pages = {23-33},
Month = {MAR},
Abstract = {African forest elephants (Loxodonta cyclotis Matschie, 1900) are
   ecological engineers that play a fundamental role in vegetation
   dynamics. The species is of immediate conservation concern, yet it is
   relatively understudied. To narrow this knowledge gap, we studied the
   drivers of daily movement patterns (linear displacements) of forest
   elephants-characterised by a set of geographical, meteorological and
   anthropogenic variables-in the Odzala-Kokoua National Park, Republic of
   Congo. Explicitly, we used conditional random forest to model and
   disentangle the main environmental factors governing the displacements
   of six forest elephants, fitted with GPS collars and tracked over 16
   months. Results indicated that females moved further distances than
   males, while the presence of roads or human settlements disrupted
   elephant behaviour resulting in faster displacements. Forest elephants
   moved faster along watercourses and through forest with understory
   dominated by Marantaceae forests and bais, but moved slower in
   savannahs. Finally, flood-prone areas-described by elevation and
   accumulated precipitation-and higher temperatures prevented longer
   displacements. We expect these results to improve the knowledge on the
   species movements through different habitats, which would benefit its
   conservation management.},
