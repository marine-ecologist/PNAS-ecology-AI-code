@article{ WOS:001792527200001,
Author = {Keski-Saari, Sarita and Keinanen, Markku and Mayra, Janne and Viinikka,
   Arto and Tanhuanpaa, Topi and Kivinen, Sonja and Poikolainen, Laura and
   Khoramshahi, Ehsan and Vihervaara, Petteri and Kumpula, Timo},
Title = {Variation in foliar chlorophyll and carotenoid contents of
   European aspen: Effect of forest structure and estimation by airborne
   hyperspectral imaging},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {96},
Month = {JUN},
Abstract = {Foliar chlorophyll (Chl) and carotenoid (Car) contents are essential
   physiological traits that reflect plant health. We investigated
   variation in these pigments in the upper crowns of European aspen
   (Populus tremula), a keynote species that supports high biodiversity in
   boreal forests through its ecological functions. We examined how Chl and
   Car contents vary with protection status and forest structural
   characteristics by airborne laser scanning (ALS) and assessed the
   potential of airborne hyperspectral imaging (HSI, 432- 810 nm) in
   combination with ALS to estimate single crown pigment distributions at
   the landscape level. Leaf-area based Chl and Car contents showed
   substantial variation. High Chl and Car content in protected zone was
   unexpected considering the older average age of the aspens. Tree and
   stand structural characteristics influenced intraspecific diversity of
   pigment contents. In non-protected and roadside zones, lower pigment
   content co-occurred with the higher tree density, which implies
   influence of shading by neighboring trees. Random forest (RF) model
   using spectral indices allowed estimation of Chl content from
   hyperspectral reflectance with coefficient of determination (R-2) of
   0.52 and relative root mean square errors (RMSE\%) of 11.7\%, whereas
   accuracy was slightly less for partial least squares regression (PLSR)
   (R-2 0.51 and RMSE 13.4\%). For Car content, the accuracies were lower
   (for PLSR R-2 0.32 and RMSE\% 13.5 and for RF R-2 0.28 and RMSE\%
   13.23). Overall, the intraspecific diversity of pigment contents of a
   keynote species was high, and influenced by structural diversity of
   forests, which can have ecological consequences for the ecosystem level
   biodiversity in boreal forests.},
