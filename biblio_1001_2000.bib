@article{ WOS:001865396200001,
Author = {Guo, Z. J. and Liu, W. C. and Zhang, X. Y. and Zhou, T. P.},
Title = {PPDIF: A PRIVACY-PRESERVING FRAMEWORK FOR WETLAND BIODIVERSITY
   MONITORING AND ECOLOGICAL RISK EARLY WARNING},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Month = {2026 JUL 16},
Abstract = {Wetland ecosystems in protected areas face growing threats from
   biodiversity loss, habitat fragmentation, and climate-induced
   disturbances. Effective ecological monitoring is difficult due to
   distributed and sensitive environmental data that limit centralized
   sharing. The research proposes a Privacy-Preserving Distributed
   Intelligence Framework (PPDIF) integrating Federated Learning (FL) and
   Differential Privacy (DP) for wetland biodiversity monitoring and
   ecological risk prediction. The framework includes dataset acquisition,
   preprocessing, classification, optimization, distributed learning, and
   privacy preservation stages. A wetland biodiversity and risk monitoring
   dataset of (4000 records with 35+ features), ecological, IoT, and
   satellite-derived attributes were preprocessed with Min-Max
   normalization to ensure consistent scaling across heterogeneous inputs.
   Random Forest (RF) is employed to learn ecological patterns and classify
   risk levels, while Namib Beetle Optimization (NBO) improves feature
   selection and parameter tuning for enhanced prediction performance. FL
   enables decentralized model training without sharing raw ecological
   dataand DP secures sensitive information through controlled noise
   injection. Experimental evaluation in Python achieved 95.67\% accuracy,
   92.96\% precision, 91.38\% recall, 93.71\% NDCG, 91.72\% mF1, and
   84.63\% mIoU, outperforming baseline methods. The framework maintains a
   balance between privacy preservation and predictive performance,
   providing a scalable and secure solution for real-world ecological
   monitoring and timely biodiversity conservation decision-making.},
