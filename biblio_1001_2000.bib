@article{ WOS:001825230200001,
Author = {Ma, Zhong and Hou, Shujuan and Ma, Weijing and Wang, Ting and Zhao,
   Huimei and Jin, Qianchen},
Title = {Coupling Coordination and Multi-Objective Optimisation of the
   Human-Water-Land System in Arid Northwest China},
Journal = {ECOHYDROLOGY},
Year = {2026},
Volume = {19},
Number = {5},
Month = {JUL 20},
Abstract = {Sustainable development in arid Northwest China depends on coordinated
   management of the water resources-socioeconomic-ecological (WSE) system.
   Understanding the interactions among these subsystems is therefore
   critical in this water-stressed region. Analysing the interplay among
   these three systems is thus critical for this water-stressed region.
   This study establishes a comprehensive evaluation framework for
   2000-2023, integrating the entropy weight method, a coupling
   coordination degree (CCD) model, grey relational analysis, random forest
   and the NSGA-II multi-objective optimisation algorithm to diagnose their
   coupling coordination dynamics. The results demonstrate that (1) the
   coupling coordination index for the arid regions of Northwest China has
   steadily increased from 0.28 in 2000 to 0.46 in 2023. Core cities such
   as Urumqi and Karamay have seen particularly significant growth
   exceeding 0.18. However, the region exhibits pronounced spatial
   differentiation and uneven development patterns. (2) The ecological
   water usage ratio and vegetation coverage rate are the most critical
   drivers for coordinated system development, with grey correlation
   coefficients of 0.946 and 0.956 respectively, which are significantly
   higher than the urbanisation rate's 0.811 and GDP growth rate's 0.736.
   (3) Multi-scenario simulations propose differentiated regulatory
   strategies, suggesting that economically developed cities under high
   water stress should prioritise integrated water-socioeconomic
   management, while ecologically fragile regions are better suited for
   synergistic water-ecological governance. (4) The study recommends
   incorporating key indicators, particularly the ecological water
   allocation ratio, into regional policy evaluation systems to advance
   precision governance models guided by water-determined development
   paradigms. This research enhances the understanding of complex
   human-land system coupling mechanisms in arid regions and provides
   methodological references for sustainable development studies.},
