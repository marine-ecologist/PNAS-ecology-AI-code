@article{ WOS:001531256100001,
Author = {Son, Seok-Jun and Choi, Han-I. and Choi, Green and Do, Min Seock and
   Nam, Hyung-Kyu},
Title = {Spatial and temporal patterns of waterbird communities and impact of
   landscape features at multi-scale in rice fields of the Korean Peninsula},
Journal = {LANDSCAPE ECOLOGY},
Year = {2025},
Volume = {40},
Number = {8},
Month = {JUL 19},
Abstract = {ContextRice paddies are considered important habitats for waterbirds
   because they offer abundant food resources and serve as stopover sites,
   breeding grounds, and wintering sites depending on spatial and temporal
   changes. Although rice paddies have been studied extensively as key
   habitats for waterbirds, research linking waterbird assemblages in rice
   paddies with multi-scale landscape factors remains
   insufficient.ObjectivesTo investigate the spatiotemporal distribution
   patterns of waterbirds that use rice paddies in the central-western
   region of Korea and the relationships between these distribution
   patterns and multi-scale landscape factors.MethodsThis study was
   conducted in rice paddy regions located in the central-western part of
   Korea. Data were collected from 40 rice paddy plots surveyed for
   waterbirds from January to December, 2017 and then analyzed.
   Self-organizing map was used to classify the waterbird assemblages, and
   random forest analysis was employed to evaluate the relationship between
   each assemblage and multi-scale landscape factors.ResultsCluster
   analysis revealed four distinct seasonal assemblages of waterbirds,
   reflecting clear temporal shifts in community composition throughout the
   year. Furthermore, the importance of multi-scale landscape factors
   varied depending on the spatial scale, indicating that identical
   landscape features can exert various effects on waterbirds depending on
   the ecological context and season.ConclusionsThe study findings provide
   foundational data for developing practical waterbird conservation
   strategies in rice paddy ecosystems, highlighting the significance of
   ecological management based on multi-scale and seasonal landscape
   considerations.},
