@article{ WOS:001559046200001,
Author = {Pou-Rossell, Marcal and Sol, Daniel and Jolles, Jolle W.},
Title = {A centralised multi-unit recording system for automated, off-grid animal
   observation and environmental monitoring},
Journal = {METHODS IN ECOLOGY AND EVOLUTION},
Year = {2025},
Volume = {16},
Number = {10},
Pages = {2335-2344},
Month = {OCT},
Abstract = {1. Automated monitoring is transforming ecological and behavioural
   research by enabling accurate, long-term data collection and processing
   with minimal intervention-especially in remote or logistically
   challenging environments. However, monitoring multiple organisms or
   sites simultaneously poses substantial logistical hurdles, including the
   need to coordinate, optimise and verify the performance of numerous
   monitoring units. 2. We present a flexible, centralised approach for
   multi-unit monitoring based on single-board computers. Unlike
   conventional systems that rely on replicated, independent units, our
   design uses a parent-child configuration to coordinate autonomous data
   collection, synchronisation and power management. The parent unit allows
   for remote control of all child units while maintaining the ability to
   configure each one individually. We outline the core principles of this
   centralised multi-unit system and discuss key challenges and
   considerations. 3. As a proof of concept, we deployed a centralised
   system to simultaneously monitor 14 nests of a colonial bird-the Jackdaw
   Corvus monedula-throughout the breeding cycle. Over 4 months, the system
   autonomously collected high-resolution, second-by-second data from
   multiple nests with minimal intervention. Using a deep-learning-based
   computer vision pipeline, we extracted detailed behavioural metrics on
   parental effort and coordination, showcasing the system's capacity to
   generate rich, fine-scale data. 4. By integrating centralised control,
   efficient power management and remote data handling, our open-source,
   low-cost approach offers a versatile and robust solution for continuous,
   non-invasive field monitoring in both accessible and remote areas. It is
   adaptable to a wide range of ecological applications, from monitoring
   long-term forest canopy dynamics to analysing fine-scale animal
   behaviour. To facilitate replication and adaptation, we provide full
   documentation for system setup, configuration and data processing.},
