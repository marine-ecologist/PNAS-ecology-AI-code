Address = {RADARWEG 29, 1043 NX AMSTERDAM, NETHERLANDS},
Type = {Article},
Language = {English},
Affiliation = {Klaoudatos, D (Corresponding Author), Univ Thessaly, Dept Ichthyol \& Aquat Environm, Fytoko St, Volos 38446, Greece.
   Pafras, D.; Politikos, D.; Theocharis, A.; Klaoudatos, D., Univ Thessaly, Dept Ichthyol \& Aquat Environm, Fytoko St, Volos 38446, Greece.
   Theocharis, A., Tech Univ Denmark, Natl Inst Aquat Resources, North Sea Sci Pk, DK-9850 Hirtshals, Denmark.},
DOI = {10.1016/j.ecoinf.2026.103968},
