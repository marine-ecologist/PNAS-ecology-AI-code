@article{ WOS:001849978800001,
Author = {Li, Shihai and Wang, Yijia and Guo, Xiaoyu and Li, Mingze and Zhou, Yubo
   and Guo, Yue and Sun, Weina and Yu, Ruixin and Ma, Zhijie and Mao,
   Zhenhua and Zhang, Xiaojuan and Na, Heya and Siqingbilige and Gao, Qian},
Title = {Reduction of bare land and landscape heterogeneity: Achievements of 30
   years of ecological restoration in Ordos},
Journal = {ECOLOGICAL FRONTIERS},
Year = {2026},
Volume = {46},
Number = {5},
Pages = {2122-2135},
Month = {OCT},
Abstract = {Ordos, a typical ecologically fragile area in northern China, has
   experienced both rapid economic development and large-scale ecological
   restoration over the past three decades, leading to complex and drastic
   land-use changes. However, existing research lacks a systematic
   assessment of the ecological and environmental changes in Ordos during
   this period. Here, we used Landsat 5/8 and Sentinel-2 remote-sensing
   imagery together with the random forest algorithm to generate land-use
   classifications, revealing the spatiotemporal landscape patterns in
   Ordos at five-year intervals from 1995 to 2024. We employed eight
   landscape pattern index to analyze their spatiotemporal dynamics and
   assess the ecological implications in this region. The results show that
   between 1995 and 2024, the areas of shrubland and grassland increased to
   51,632 km2, indicating the initial effectiveness of ecological
   restoration. Furthermore, our analysis reveals a growing trend of
   landscape fragmentation and a significant increase in diversity in the
   southeast and northeast regions during the study period. Specifically,
   the Largest Patch Index (LPI) of bare land decreased from 14\% to 8\%,
   reflecting the fragmentation of large patches. Meanwhile, the
   Aggregation Index (AI) increased from 90\% to 93\%, suggesting that
   ecological restoration efforts successfully converted small, scattered
   patches of bare land into vegetation, thereby causing the remaining bare
   land areas to become more aggregated. This study provides a reference
   for evaluating the effectiveness of major national ecological projects
   and optimizing regional territorial spatial planning.},
