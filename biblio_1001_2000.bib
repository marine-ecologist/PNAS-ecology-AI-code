@article{ WOS:001745584400001,
Author = {Nie, Lisha and Wang, Leiguang and Li, Yuxuan and Yang, Peirou and Lv,
   Zhigang and Liu, Yun and Xu, Weiheng and Ou, Guanglong and Kou, Weili},
Title = {Forest fire risk zonation in Yunnan Province using multi-source
   indicators and interpretable machine learning},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {95},
Month = {MAY},
Abstract = {Forest fire represents a major ecological disturbance that threatens
   forest health, disrupts ecosystem services, and undermines regional
   ecological security. In Yunnan Province, southwestern China, complex
   topography, diverse climatic conditions, intensive human activities, and
   strong temporal variability create highly heterogeneous forest fire risk
   patterns that are insufficiently captured by conventional fire danger
   rating systems. To address this gap, we developed a temporally robust
   and interpretable forest fire risk zoning framework that combines
   multi-source natural and anthropogenic indicators with advanced machine
   learning techniques. This study advances forest fire risk assessment in
   three main ways. First, an annual dual-selection strategy combining
   Pearson correlation analysis and SHapley Additive exPlanations (SHAP)
   analysis was used to identify non-redundant and temporally robust
   fire-driving factors. Second, a structured comparison was conducted
   across an interpretable single-tree baseline and multiple ensemble
   strategies, including Random Forest (RF), Gradient Boosting Decision
   Tree (GBDT), eXtreme Gradient Boosting (XGBoost), and a Stacking model,
   to clarify their relative strengths and the added value of model
   integration. Third, conventional cross-validation was used to assess
   overall predictive performance, while temporal extrapolation and
   independent ground-based fire records were further used to verify the
   robustness and practical reliability of the cross-validation results.
   Using fire occurrence data from 2001 to 2020, the cross-validation
   results showed that GBDT achieved the best predictive performance (AUC =
   0.890), followed by the Stacking model (AUC = 0.873). In temporal
   extrapolation, GBDT, Stacking, RF, and XGBoost all maintained AUC values
   above 0.80, indicating good robustness under interannual variability.
   The resulting fire risk maps reveal clear spatial heterogeneity in
   forest fire risk, with high-and extremely high-risk zones concentrated
   in Pu'er, Xishuangbanna, and other ecologically sensitive areas, while
   high-elevation regions such as Diqing and northern Nujiang exhibited low
   risk. Importantly, anthropogenic indicators such as nighttime lights,
   road proximity, and the human footprint significantly shaped fire risk
   patterns, underscoring the necessity of integrating human activity
   factors. This study demonstrates that interpretable machine
   learning-based risk zoning provides a robust ecological indicator for
   forest fire management, offering scientific support for early-warning
   systems, land use planning, and ecological security strategies in
   fire-prone mountainous regions.},
