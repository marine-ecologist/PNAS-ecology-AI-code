@article{ WOS:001615465300001,
Author = {Cao, Aihua and Dong, Chun},
Title = {Unveiling the Nexus between Ecosystem Health and Land-Use Structure in
   the Yangtze and Yellow River Basins, China},
Journal = {ECOSYSTEM HEALTH AND SUSTAINABILITY},
Year = {2025},
Volume = {11},
Month = {NOV 17},
Abstract = {The Yellow River Basin (YRB) and the Yangtze River Basin (YZRB) are the
   two core regions of China's agricultural development. Understanding
   ecosystem health (EH) dynamics and mitigating land-use change impacts
   are crucial for optimizing territorial spatial planning. This study
   introduces an innovative approach by incorporating the comprehensive
   ecosystem service index (CESI), constructed through multiplication
   methodology, into the improved
   vitality-organization-resilience-ecosystem services (VORS) framework for
   long-term EH monitoring. It integrates this index with random forest and
   segmented linear regression models to identify key land-use types and
   their thresholds affecting EH. The findings indicate that (a) ecosystem
   services demonstrated significant spatial heterogeneity, with an overall
   upward trend in supply from 2000 to 2020; (b) the YZRB exhibited higher
   overall ecosystem health index (EHI) than did the YRB, with growth
   primarily driven by ecosystem vitality improvements; (c) the EHIs
   displayed less variation in the east-west direction, while variation in
   the north-south direction was more pronounced; and (d) cultivated land,
   forest land, grass land, and construction land emerged as the primary
   land-use types affecting EH. These insights provide valuable guidance
   for policy formulation and establish a foundation for further
   theoretical and practical research on regional ecological security.},
