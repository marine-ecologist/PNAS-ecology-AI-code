@article{ WOS:000461678300351,
Author = {Cai, Dongna},
Title = {Ecological Study of the Application of Flowers Plant Real-time
   Observation and 3D Reconstruction based on Kinect},
Journal = {EKOLOJI},
Year = {2019},
Volume = {28},
Number = {107},
Pages = {3143-3149},
Abstract = {The Kinect shows some limitations for ecological observation associated
   with a short measurement range and daytime light contamination.
