@article{ WOS:001534257900001,
Author = {Zhao, Fan and Xu, Decong and Ren, Zhiyan and Shao, Xinlei and Wu,
   Qingyang and Liu, Yongying and Wang, Jiaqi and Song, Jian and Chen,
   Yijia and Zhang, Guochen and Fujimoto, Yasufumi and Shimada, Tetsuo and
   Mizuno, Katsunori},
Title = {Mamba-based super-resolution and semi-supervised YOLOv10 for freshwater
   mussel detection using acoustic video camera: A case study at Lake
   Izunuma, Japan},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2025},
Volume = {90},
Month = {DEC},
Abstract = {Freshwater mussels are essential for maintaining the balance and
   ecological integrity of aquatic environments. Continuous monitoring of
   mussel populations provides critical insights into ecosystem dynamics,
   and supports conservation and benthic resource management. However,
   traditional monitoring methods face challenges, such as water clarity
   issues, labour-intensive surveys, outdated technologies, incomplete
   datasets, and limited spatial coverage. In a field survey at Lake
   Izunuma, Japan, a new mussel-monitoring approach was developed for
   turbid underwater environments using a custom-designed Sonar Speedy
   Scanner (SonarSS) system integrated with Mamba-based image
   reconstruction and an improved YOLOv10 identification model
   (Mussel-YOLO). The MambaIR model reconstructed super-resolution images
   that were processed using the Mussel-YOLO model for precise mussel
   detection. Among seven evaluated super-resolution reconstruction
   methods, MambaIR demonstrated superior performance, achieving a
   signal-to-noise ratio (PSNR) of 32.33 dB and a structural similarity
   index metric (SSIM) of 74.29 \%, delivering excellent image quality.
   Mussel detection using MambaIR-generated images achieved the highest
   accuracy with an mAP50 of 91.4 \% at optimal magnification. This
   research has significant implications for the biodiversity conservation,
   resource management, and environmental monitoring in low-transparency
   waters. This method supports sustainable and cost-effective conservation
   practices by enhancing underwater species detection accuracy and
   reducing manual labour. In addition, it can be applied to other areas,
   such as monitoring invasive species or assessing aquatic ecosystem
   health in response to climate change.},
