Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Lecomte, N (Corresponding Author), Univ Moncton, Dept Biol, Canada Res Chair Polar \& Boreal Ecol, Moncton, NB, Canada.
