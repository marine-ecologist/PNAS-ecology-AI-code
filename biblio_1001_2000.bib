@article{ WOS:001801649200001,
Author = {Feng, Guoliang and Fang, Chuanxu and Liu, Hongyang and Peng, Zhao and
   Tong, Xinpeng and Qin, Xin and Qiu, Liping and Wei, Xiaorong},
Title = {Microbial phosphorus limitation indirectly regulates soil
   multifunctionality via microbial functional genes during vegetation
   succession},
Journal = {AGRICULTURE ECOSYSTEMS \& ENVIRONMENT},
Year = {2026},
Volume = {411},
Month = {NOV 1},
Abstract = {Understanding how nutrient limitation regulates soil multifunctionality
   (SMF) during vegetation succession is critical for predicting ecosystem
   recovery following agricultural abandonment, yet the underlying
   microbial mechanisms remain poorly resolved. Here, we investigated soil
   nutrient stoichiometry, microbial resource limitation, functional gene
   abundance, and SMF along a vegetation successional gradient in a
   semiarid agroecosystem. We found that succession amplified soil
   stoichiometric imbalances, leading to intensified microbial phosphorus
   (P) limitation. This shift was accompanied by a reorganization of
   microbial functional potential, characterized by altered abundances of
   genes involved in carbon (C), nitrogen (N), and phosphorus cycling.
   Notably, SMF exhibited a pronounced nonlinear response to succession,
   with an initial decline during early stages followed by recovery at
   later stages. Using random forest and structural equation modeling, we
   show that the effects of microbial P limitation on SMF are primarily
   indirect, operating through microbial functional gene abundance rather
   than direct suppression of ecosystem processes. Despite P being the
   primary limiting nutrient, N-cycling genes emerged as strong predictors
   of SMF, suggesting that nitrogen transformations play a central role in
   integrating biogeochemical processes under nutrient constraints.
   Collectively, our results support a geneassociated pathway linking
   nutrient limitation to ecosystem functioning and demonstrate that SMF is
   closely associated with shifts in microbial functional capacity under
   stoichiometric constraints. This study provides a mechanistic framework
   for understanding how nutrient imbalances regulate ecosystem recovery
   and offers new insights into predicting ecosystem responses to
   environmental change.},
