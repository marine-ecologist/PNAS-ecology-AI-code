@article{ WOS:001767204400001,
Author = {Fang, Y. and Ou, Q. W. and Wu, Z. L. and Gou, Z. Y. and Zhao, X. and Li,
   P. L. and Huang, H.},
Title = {Machine learning-based identification of dominant phytoplankton species
   in the Gouqi Island mussel aquaculture area of the East China Sea},
Journal = {REGIONAL STUDIES IN MARINE SCIENCE},
Year = {2026},
Volume = {97},
Month = {MAY},
Abstract = {Accurate identification of the composition and variability of dominant
   phytoplankton species is essential for evaluating marine ecological
   health and water quality, and is also crucial for supporting effective
   disaster early warning. However, effective phytoplankton monitoring in
   nearshore waters is often constrained by complex backgrounds,
   multi-scale targets, and the need for efficient and timely data
   processing. In this study, we develop a lightweight image-based deep
   learning framework for the identification of dominant phytoplankton
   species in the Gouqi Island mussel aquaculture area of the East China
   Sea. The proposed approach is designed to improve detection performance
   under complex coastal conditions while reducing computational cost,
   thereby facilitating practical applications in marine monitoring
   scenarios. Experimental results demonstrate that the proposed framework
   achieves improved identification accuracy and efficiency compared with a
   baseline detection model, with notable gains in precision, recall, and
   overall detection performance. Ablation experiments further confirm the
   contributions of the integrated modules to multi-scale feature
   representation and model efficiency. This study provides a practical and
   scalable technical solution for automated phytoplankton monitoring in
   coastal aqua-culture environments and highlights the potential of
   machine learning-based approaches to support regional marine ecosystem
   assessment and management.},
