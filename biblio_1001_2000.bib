@article{ WOS:001845648300001,
Author = {Cruz-Burga, Zoila Aurora and Fernandez-Heaton, Berenice del Milagro and
   Ibanez-Blancas, Alexis Nicolas and Chavez-Achong, Julio Alberto and
   Sanchez-Uzcategui, Jose Miguel},
Title = {Socio-ecological drivers of forest-use change in the coffee landscapes
   of Chanchamayo, Peru},
Journal = {FRONTIERS IN FORESTS AND GLOBAL CHANGE},
Year = {2026},
Volume = {9},
Month = {JUL 29},
Abstract = {Introduction Coffee production sustains rural livelihoods in the
   Peruvian Andean Amazon but also intensifies pressure on tropical
   mountain forests, particularly where land constraints, climate
   vulnerability, and deforestation-free market standards converge. In this
   study, we examined the factors associated with reported forest-use
   change among coffee producers affiliated with two cooperatives in
   Chanchamayo and explored the broader socio-ecological configurations of
   their households and production systems.Methods A mixed-methods design
   combined surveys of 253 cooperative members with interviews and
   participatory workshops. A Probit model was complemented by bivariate,
   Random Forest, principal component, and multiple correspondence
   analyses.Results Secondary education (relative to primary education),
   higher coffee yield, compost use, and local identity were associated
   with a lower probability of reported forest-use change. In contrast,
   perceived benefits from purma (i.e., secondary forests), the intention
   to replace coffee areas within the next two years, and larger
   agricultural areas were associated with a higher probability. Coffee
   yield, agricultural area, altitude, access to credit, and compost use
   were the most predictive factors. The different methods employed
   identified a predominant production-economic dimensions distinct from
   elevation conditions and revealed broader relationships between
   production type, certification, access to resources, purma valuation,
   and sociocultural and climate-related characteristics.Conclusion These
   findings suggest that reducing forest conversion in the studied coffee
   landscapes requires policies that integrate productivity improvements
   within existing farms with sustainable purma management and locally
   differentiated technical support.},
