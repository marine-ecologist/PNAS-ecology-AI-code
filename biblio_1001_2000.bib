@article{ WOS:001615431000024,
Author = {Zhang, Rui and Fan, Linfeng and Huang, Min and Zheng, Chunmiao},
Title = {Spatiotemporal dynamics of land cover on the Tibetan Plateau
   (2000-2020): Evidence of greening and wetting},
Journal = {ECOLOGICAL FRONTIERS},
Year = {2025},
Volume = {45},
Number = {6},
Pages = {1763-1773},
Month = {DEC},
Abstract = {Cryosphere degradation present persistent challenges across the Tibetan
   Plateau, a region characterized by fragile ecosystems and climate
   sensitivity. To support the monitoring and evaluation of SDG 15.3, we
   developed a high-resolution, temporally consistent land cover dataset
   for 2000, 2010, and 2020 using over 15,000 Landsat scenes processed in
   Google Earth Engine. A total of 32 features-including spectral bands,
   indices, topography, and PCA components-were optimized using a genetic
   algorithm and classified via random forest into nine harmonized land
   cover types. The overall accuracy of the classification reached 85 \%
   with a Kappa coefficient of 0.82. Our results reveal clear greening and
   wetting trends across the TP over the past two decades. Barren land in
   inland regions has undergone widespread conversion to grassland,
   especially in the 4000-5400 m elevation range, with greening rates
   increasing along this gradient. Concurrently, the area of water bodies
   expanded significantly, particularly at elevations of 4000-5200 m and
   2600-3600 m. In contrast, low-elevation zones (<3000 m) experienced
   vegetation degradation associated with the expansion of cropland and
   artificial surfaces. These findings offer important insights into the
   ecological transitions occurring in high-altitude cryosphere regions and
   provide robust baseline data for land degradation monitoring, ecological
   restoration planning, and climate adaptation policy.},
