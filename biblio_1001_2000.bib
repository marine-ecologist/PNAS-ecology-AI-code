@article{ WOS:001780804100001,
Author = {Xie, Ying-hong and Hong, Zi-wen and Liu, Yin-shu and Zhou, Qi-hai and
   Cao, Zhong and Fan, Peng-lai},
Title = {Passive acoustic monitoring reveals the diurnal calling activity and
   habitat selection of white-headed langurs},
Journal = {ECOLOGICAL INFORMATICS},
Year = {2026},
Volume = {96},
Month = {JUN},
Abstract = {Nonhuman primates are crucial to biodiversity and ecosystem functioning.
   However, behavioral and ecological monitoring remains challenging due to
   the complexity of their habitats and the limitations of traditional
   monitoring methods. Therefore, this study aimed to characterize the
   diurnal calling activity and habitat selection of the white-headed
   langur using passive acoustic monitoring (PAM) combined with deep
   learning. A deep learning model, DeepADN-Plus, was developed to
   automatically detect the long-distance calls of the critically
   endangered white-headed langur (Trachypithecus leucocephalus). The
   training data included manually collected acoustic recordings obtained
   from April 2020 to August 2023 and autonomous recording unit (ARU) data
   collected from September to December 2023 in the Chongzuo White-headed
   Langur National Nature Reserve, Guangxi, China. The model demonstrated
   strong robustness in noisy environments, achieving a recall of 99.1\%
   and an F1-score of 91.3\%. From December 2023 to June 2024, PAM
   conducted across 86 sites detected langur calls at 80 sites (93.0\%)
   using the developed DeepADN-Plus model, indicating a broad distribution
   within the study area. Meanwhile, the deep learning model reduced the
   manual workload by 99.2\%. Calling activity exhibited a bimodal pattern,
   with a pronounced peak in the early morning and a moderate peak in the
   afternoon. Proximity to cliffs positively influenced calling activity,
   whereas the effect of proximity to human-modified land was negligible,
   suggesting adaptation to fragmented habitats. Langurs also preferred
   calling in areas with sparse vegetation, likely to reduce signal
   attenuation. The integration of PAM and deep learning provides an
   advanced, noninvasive approach for monitoring limestone langur
   populations, offering valuable insights for conservation management
   within this habitat patch and serving as a methodological reference for
   similar studies on other primates.},
