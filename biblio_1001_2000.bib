@article{ WOS:001857892300001,
Author = {Soltani, Mohammad Javad and Latifi, Hooman and Naghavi, Hamed},
Title = {Hybrid Data Augmentation and Object-Based Analysis for LULC Mapping with
   Imbalanced Training Data in Complex Wetlands},
Journal = {WETLANDS},
Year = {2026},
Volume = {46},
Number = {7},
Month = {AUG 25},
Abstract = {Accurate Land Use/Land Cover (LULC) classification in complex
   agro-wetland ecosystems remains constrained by two persistent
   challenges: (1) severe class imbalance, where ecologically critical
   classes are heavily underrepresented in training data, and (2) spectral
   heterogeneity, where mixed and transitional land covers exhibit
   overlapping spectral signatures. To address spectral heterogeneity, we
   employ Object-Based Image Analysis (OBIA), which aggregates pixels into
   spectrally homogeneous segments and reduces within-class variability.
   Simultaneously, we integrate selective data augmentation to synthesize
   training samples for minority classes, which prevents classifier bias
   toward dominant categories and corrects data imbalance. This framework
   was applied to a degraded semi-arid wetland in western Iran, using
   Sentinel-1 and Sentinel-2 imagery. We optimized eighteen spectral
   indices, textural metrics, and radar backscatter features via feature
   engineering and a SelectKBest approach. These were then evaluated using
   Random Forest and Extra Trees classifiers. Among the tested augmentation
   strategies, Borderline-SMOTE combined with Extra Trees achieved the most
   balanced performance, with minority-class F1-scores increasing by more
   than 20\% over baselines. This improvement ensured the retention of rare
   categories, such as Plowed land and Degraded wetland, which provide
   critical insights into drought-driven desiccation and anthropogenic
   pressure. Annual LULC transitions (2019-2024) revealed fluctuating
   cropland extent, wetland vegetation decline, and intermittent
   plowed/bare areas driven by climatic variability and human activity. The
   results demonstrate that coupling targeted augmentation with feature
   selection and object-based analysis effectively mitigates class
   imbalance while preserving ecological interpretability, offering a
   transferable framework for monitoring dynamic degraded wetland
   ecosystems.},
