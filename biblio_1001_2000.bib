@article{ WOS:001597622100002,
Author = {Porras, Abel A. and Jin, Young-Hoon and Peacock, Edward and Avila,
   Yazmin and Chu, Andrew N. and Mahaseth, Harshita and Santiago, Angel L.
   and Siegmund, Julia G.},
Title = {Expanding an urban stream ecological monitoring system with functional
   data analysis and deep learning},
Journal = {FRESHWATER SCIENCE},
Year = {2025},
Volume = {44},
Number = {4},
Pages = {660-673},
Month = {DEC 1},
Abstract = {The City of Austin (Texas, USA) (COA) Watershed Protection Department
   (WPD) is currently facing the competing challenges of managing its
   growing infrastructure (i.e., storm sewer pipes, impervious cover) while
   providing human and ecosystem services. Thus, improved modeling
   approaches are needed to monitor the ecology of its streams at a finer
   scale, with the goal of detecting changes from increased urban
   pressures. To that end, WPD has built 9 watershed models for 12
   watersheds covering similar to 250 km2 within the full-purpose
   jurisdiction of the COA with the primary purpose of linking hydrologic
   information to ecological metrics for its routine ecological monitoring
   plan. These models were constructed to simulate the hydrology of the
   watersheds under current land uses, impervious cover conditions, soil
   types, geologic information, and watershed topography. All models were
   run over a simulation period of 8 y (2011-2018), resulting in
   hydrographs at points along the stream coincident with points at which
   benthic macroinvertebrate community data were collected.
   Macroinvertebrate community data were used to create pollution optima
   metrics, which allowed for evaluation of the ecological characteristics
   of the stream. The coincident hydrologic and pollution optima metrics
   were then applied to functional data analysis (FDA) and deep learning
   (DL) models and cross-validated with testing data. The DL model
   performed better (measured as higher R2 values) than FDA models in the
   initial model evaluation, but its performance declined during
   cross-validation, indicating limited applicability across datasets in
   Austin. Nonetheless, some site-level predictions, such as lower
   pollution optima metrics in highly urbanized reaches, were consistent
   with observed ecological patterns. Although FDA results showed limited
   ability to predict at unsampled stream locations, DL appears to be a
   promising approach for estimating ecological metrics in these areas,
   providing a basis for identifying potential ecological concerns and
   prioritizing follow-up sampling to address water-quality deterioration.},
