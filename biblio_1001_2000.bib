@article{ WOS:001739886900001,
Author = {Liu, Qiming and Shen, Zehao and Zhou, Mei},
Title = {Spatio-temporal patterns and drivers of fire spread and severity: a case
   study of an extreme wildfire in China's boreal forests},
Journal = {FIRE ECOLOGY},
Year = {2026},
Volume = {22},
Number = {1},
Month = {FEB 25},
Abstract = {BackgroundWildfire behavior results from nonlinear interactions among
   weather, fuel, topography, and human activities. Understanding the
   spatio-temporal characteristics of fire events is essential for gaining
   a deeper understanding of fire behavior and improving model predictions.
   However, real-time data collection on large wildfire events remains
   challenging, particularly for fires that occurred in earlier years. This
   study examines the 2003 ``Jinhe 5 \& centerdot;5 Fire{''} (105,834 ha)
   in China' s Greater Khingan Mountains, a critical ecological barrier and
   wildfire-prone region, to identify fire behavior patterns and
   influencing factors.MethodsWe retrieved burn dates from the MCD14DL
   active fire data and quantified fire severity using the Differenced
   Normalized Burn Ratio (dNBR) derived from Landsat imagery. Due to the
   limited availability of data, semivariogram analysis was employed to
   assess the spatial heterogeneity of burn dates and fire severity.
   Furthermore, we used a random forest model to identify the key factors
   influencing fire severity.ResultsThe main findings include: 1) The
   wildfire initially spread rapidly along roads from the ignition point in
   the northwest to the southeastern end of the burned area, later
   expanding perpendicularly (NE-SW). 2) Fire severity was highest on
   steeper slopes and in areas with rapid fire spread. 3) Pre-fire climate
   moisture and under-fire wind, as the main drivers of fire severity, were
   further influenced by human activities and topography.ConclusionsThe
   spatial pattern of fire severity is jointly determined by fire spread
   dynamics and environmental factors, with faster-spreading fires
   exhibiting higher severity. These findings provide valuable insights
   into fire spread dynamics and spatial variability, informing fire
   prevention and post-disaster recovery strategies.
   AntecedentesEl comportamiento del fuego resulta de interacciones no
   lineares entre el tiempo meteorol \& oacute;gico, los combustibles, la
   topograf \& iacute;a, y las actividades humanas. El entender las
   caracter \& iacute;sticas espacio-temporales de los eventos de fuego es
   esencial para poder tener un entendimiento m \& aacute;s profundo sobre
   el comportamiento del fuego y mejorar las predicciones de los modelos.
   Por supuesto, la colecci \& oacute;n de datos en tiempo real todav \&
   iacute;a resulta desafiante, particularmente en aquellos fuegos
   recientes. Este estudio examina el incendio denominado ``Jinhe 5 \&
   centerdot;5 Fire{''} (que cubri \& oacute; 105.834 ha) ocurrido en las
   grandes monta \& ntilde;as Khingan de China, una barrera ecol \&
   oacute;gica cr \& iacute;tica y propensa a incendios, para identificar
   los patrones de comportamiento y los factores que los influencian.M \&
   eacute;todosRegistramos y compilamos datos de fechas de quemas del
   archivo activo de incendios MCD14DL, y cuantificamos la severidad del
   incendio usando la Diferencia de la Relaci \& oacute;n Normalizada de
   Quema (dNBR), derivada de im \& aacute;genes Landsat. Dada la limitada
   disponibilidad de datos, el an \& aacute;lisis de semivariogramas fue
   empleado para determinar la heterogeneidad espacial de las fechas de
   quemas y la severidad de los incendios. Usamos asimismo el modelo
   forestal al azar (Random Forest Model) para identificar los factores
   clave que influenciaron la severidad del fuego.ResultadosLos principales
   resultados incluyen: 1) el incendio propag \& oacute; primero r \&
   aacute;pidamente a lo largo de caminos desde el punto de ignici \&
   oacute;n en el noroeste y hacia el final del \& aacute;rea quemada en el
   sudeste, y luego se expandi \& oacute; de manera perpendicular (del
   noreste hacia el sudoeste). 2) la severidad del fuego fue mayor en las
   laderas escarpadas y en \& aacute;reas con r \& aacute;pida propagaci \&
   oacute;n del fuego. 3) La humedad ambiente antes del incendio y bajo el
   viento del incendio, como los principales conducentes de la severidad
   del incendio, fue luego influenciada por las actividades humanas y la
   topograf \& iacute;a.ConclusionesLos patrones espaciales de la severidad
   del fuego fueron determinados conjuntamente por la din \& aacute;mica
   propia de la propagaci \& oacute;n del fuego y los factores ambientales,
   en los cuales los fuegos m \& aacute;s r \& aacute;pidos exhibieron una
   mayor severidad. Estos resultados proveen de un conocimiento valioso
   sobre la din \& aacute;mica de la propagaci \& oacute;n del fuego y su
   variabilidad espacial, lo que permite informar sobre estrategias de
   prevenci \& oacute;n de incendios y sobre la recuperaci \& oacute;n
   luego de eventos de fuego.},
Publisher = {SPRINGER},
