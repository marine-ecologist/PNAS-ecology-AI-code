@article{ WOS:001772122200001,
Author = {Ashley-Wheeler, Victoria R. and Wyness, Adam J. and Morrissey, Barbara
   J. and Svobodova, Dasha and Telfer, Trevor C. and Wilding, Thomas A.},
Title = {Effect of Time and Temperature Before Preservation on Bacterial eDNA in
   Sediment Samples},
Journal = {ENVIRONMENTAL DNA},
Year = {2026},
Volume = {8},
Number = {3},
Month = {MAY 23},
Abstract = {Environmental DNA is being increasingly used for research and regulatory
   purposes, but currently the lack of standardization is holding it back.
   There are gaps in our understanding of the eDNA analysis pipeline and
   the potential impacts of areas of variability within that.
   Standardization is necessary for all uses of eDNA to allow comparison
   between sample sets and ensure accuracy and reproducibility.
   Understanding sample stability is particularly important for planning
   fieldwork and writing practicable guidance for regulatory compliance
   monitoring. Samples collected for eDNA analysis are preserved as soon as
   possible for stability, but practicalities of sampling in the field can
   lead to delays where the sample temperature may be uncontrolled. We
   collected eDNA sediment samples along an organic enrichment impact
   gradient and incubated them at 10 degrees C, 20 degrees C, and 40
   degrees C for up to 48 h prior to preservation, then sequenced the
   bacterial 16S gene. We show that bacteria families responded differently
   to the incubation temperatures and times to an extent that affected
   ecological interpretation. Predictions of benthic health using a trained
   random forest machine learning model were tolerant of incubation up to
   20 degrees C, and showed sensitivity to temperature within 3 h of
   incubation at 40 degrees C. We show that the influence of temperature
   can depend on the study aim, taxa involved, and analysis used, such that
   some situations may allow temporary storage up to 20 degrees C but
   others will be affected by 10 degrees C. We confirm that keeping
   sediment temperature low is critical for many applications, and that
   potential temperature deviations must be reported.},
